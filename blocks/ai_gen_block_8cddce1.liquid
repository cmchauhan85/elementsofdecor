{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-editorial-featured-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    overflow: hidden;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 500px;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 500px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-editorial-featured-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.featured_text_color }};
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    font-weight: 600;
    display: inline-block;
  }

  .ai-editorial-featured-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
    line-height: 1.2;
    margin: 0 0 12px 0;
    font-weight: 700;
  }

  .ai-editorial-featured-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_font_size }}px;
    line-height: 1.6;
    margin: 0 0 16px 0;
    opacity: 0.95;
  }

  .ai-editorial-featured-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_font_size }}px;
    opacity: 0.85;
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-article-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background-color: {{ block.settings.article_bg_color }};
    padding: {{ block.settings.article_padding }}px;
    transition: transform 0.3s ease;
  }

  .ai-editorial-article-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-editorial-article-image-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-article-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-article-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 150px;
    max-height: 150px;
  }

  .ai-editorial-article-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-editorial-article-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.article_category_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
    font-weight: 600;
    display: inline-block;
  }

  .ai-editorial-article-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.article_title_size }}px;
    line-height: 1.3;
    margin: 0 0 8px 0;
    color: {{ block.settings.text_color }};
    font-weight: 700;
  }

  .ai-editorial-article-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.article_excerpt_size }}px;
    line-height: 1.5;
    margin: 0 0 12px 0;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-editorial-article-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.article_meta_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-featured-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-editorial-featured-image-{{ ai_gen_id }},
    .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
      min-height: 400px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px;
    }

    .ai-editorial-featured-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.featured_title_size | times: 0.7 }}px;
    }

    .ai-editorial-featured-image-{{ ai_gen_id }},
    .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
      min-height: 300px;
    }

    .ai-editorial-article-image-{{ ai_gen_id }},
    .ai-editorial-article-placeholder-{{ ai_gen_id }} {
      height: 180px;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }} class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <article class="ai-editorial-featured-{{ ai_gen_id }}">
      {% if block.settings.featured_image %}
        <img
          src="{{ block.settings.featured_image | image_url: width: 1200 }}"
          alt="{{ block.settings.featured_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.featured_image.width }}"
          height="{{ block.settings.featured_image.height }}"
          class="ai-editorial-featured-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-editorial-featured-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
            Add a featured image
          </div>
        </div>
      {% endif %}

      <div class="ai-editorial-featured-content-{{ ai_gen_id }}">
        {% if block.settings.featured_category != blank %}
          <span class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.featured_category }}</span>
        {% endif %}

        {% if block.settings.featured_title != blank %}
          <h2 class="ai-editorial-featured-title-{{ ai_gen_id }}">{{ block.settings.featured_title }}</h2>
        {% endif %}

        {% if block.settings.featured_excerpt != blank %}
          <div class="ai-editorial-featured-excerpt-{{ ai_gen_id }}">{{ block.settings.featured_excerpt }}</div>
        {% endif %}

        {% if block.settings.featured_author != blank or block.settings.featured_date != blank %}
          <div class="ai-editorial-featured-meta-{{ ai_gen_id }}">
            {% if block.settings.featured_author != blank %}
              By {{ block.settings.featured_author }}
            {% endif %}
            {% if block.settings.featured_author != blank and block.settings.featured_date != blank %}
              •
            {% endif %}
            {% if block.settings.featured_date != blank %}
              {{ block.settings.featured_date }}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </article>

    <aside class="ai-editorial-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign article_image_key = 'article_' | append: i | append: '_image'
          assign article_category_key = 'article_' | append: i | append: '_category'
          assign article_title_key = 'article_' | append: i | append: '_title'
          assign article_excerpt_key = 'article_' | append: i | append: '_excerpt'
          assign article_author_key = 'article_' | append: i | append: '_author'
          assign article_date_key = 'article_' | append: i | append: '_date'

          assign article_image = block.settings[article_image_key]
          assign article_category = block.settings[article_category_key]
          assign article_title = block.settings[article_title_key]
          assign article_excerpt = block.settings[article_excerpt_key]
          assign article_author = block.settings[article_author_key]
          assign article_date = block.settings[article_date_key]
        %}

        <article class="ai-editorial-article-{{ ai_gen_id }}">
          {% if article_image %}
            <img
              src="{{ article_image | image_url: width: 600 }}"
              alt="{{ article_image.alt | escape }}"
              loading="lazy"
              width="{{ article_image.width }}"
              height="{{ article_image.height }}"
              class="ai-editorial-article-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-editorial-article-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-editorial-article-content-{{ ai_gen_id }}">
            {% if article_category != blank %}
              <span class="ai-editorial-article-category-{{ ai_gen_id }}">{{ article_category }}</span>
            {% endif %}

            {% if article_title != blank %}
              <h3 class="ai-editorial-article-title-{{ ai_gen_id }}">{{ article_title }}</h3>
            {% else %}
              <h3 class="ai-editorial-article-title-{{ ai_gen_id }}">Article {{ i }} title</h3>
            {% endif %}

            {% if article_excerpt != blank %}
              <div class="ai-editorial-article-excerpt-{{ ai_gen_id }}">{{ article_excerpt }}</div>
            {% endif %}

            {% if article_author != blank or article_date != blank %}
              <div class="ai-editorial-article-meta-{{ ai_gen_id }}">
                {% if article_author != blank %}
                  By {{ article_author }}
                {% endif %}
                {% if article_author != blank and article_date != blank %}
                  •
                {% endif %}
                {% if article_date != blank %}
                  {{ article_date }}
                {% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </aside>
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const articles = this.querySelectorAll('.ai-editorial-featured-{{ ai_gen_id }}, .ai-editorial-article-{{ ai_gen_id }}');
        articles.forEach((article) => {
          article.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

