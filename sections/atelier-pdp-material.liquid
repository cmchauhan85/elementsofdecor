{%- liquid
  assign mat_title = product.metafields.atelier.material_title.value
  assign mat_body = product.metafields.atelier.material_body
  assign mat_img = product.images[1] | default: product.images[0]
-%}
{%- if mat_body != blank -%}
<style>
.atl-mat{background:#14213d;color:#f5f2eb;padding:6.4rem 0}
.atl-mat__in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,40rem);gap:7rem;align-items:center}
.atl-mat__eye{margin:0 0 1.8rem;font-size:1.2rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#e8613c;line-height:1.2}
.atl-mat__h{margin:0 0 2.4rem;font-family:var(--font-heading-family);font-weight:400;font-size:clamp(3.2rem,4.4vw,4.8rem);line-height:1.08;color:#fff;letter-spacing:var(--a-display-tracking,0);text-wrap:balance}
.atl-mat__body,.atl-mat__body p{margin:0;max-width:52ch;font-size:1.8rem;line-height:1.65;color:rgba(245,242,235,.86)}
.atl-mat__img{aspect-ratio:4/5;border-radius:.6rem;overflow:hidden;background:#1d2d52}
.atl-mat__img img{display:block;width:100%;height:100%;object-fit:cover}
@media(max-width:749px){.atl-mat{padding:4.4rem 0}.atl-mat__in{grid-template-columns:1fr;gap:2.8rem}.atl-mat__img{order:-1;aspect-ratio:1/1}.atl-mat__body,.atl-mat__body p{font-size:1.6rem}}
</style>
<div class="atl-mat">
  <div class="page-width atl-mat__in">
    <div class="atl-mat__text">
      <p class="atl-mat__eye">On material</p>
      {%- if mat_title != blank -%}<h2 class="atl-mat__h">{{ mat_title }}</h2>{%- endif -%}
      <div class="atl-mat__body rte">{{ mat_body | metafield_tag }}</div>
    </div>
    {%- if mat_img != blank -%}
      <div class="atl-mat__img">{{ mat_img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 990px) 40rem, 100vw', alt: mat_img.alt | default: product.title | escape }}</div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "On Material",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "On Material" }]
}
{% endschema %}
