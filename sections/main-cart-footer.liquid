{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'section-atelier-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'hold_timer' -%}
              {%- if cart != empty -%}
                <div
                  class="atelier-hold"
                  data-hold-duration="{{ block.settings.duration_minutes }}"
                  data-hold-label="{{ block.settings.label | escape }}"
                  data-hold-expired="{{ block.settings.expired_text | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <span class="atelier-hold__icon" aria-hidden="true">◷</span>
                  <div class="atelier-hold__body">
                    <span class="atelier-hold__label">{{ block.settings.label }}</span>
                    <strong class="atelier-hold__time" aria-live="polite">—:——</strong>
                  </div>
                </div>
              {%- endif -%}
            {%- when 'gift_note' -%}
              <div class="atelier-cart-gift" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="atelier-cart-gift__toggle"
                  aria-expanded="false"
                  aria-controls="CartGiftPanel-{{ section.id }}"
                  onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded')==='true'?'false':'true'); document.getElementById('CartGiftPanel-{{ section.id }}').hidden = !document.getElementById('CartGiftPanel-{{ section.id }}').hidden;"
                >
                  <span class="atelier-cart-gift__toggle-label">{{ block.settings.toggle_label }}</span>
                  <span class="atelier-cart-gift__toggle-icon" aria-hidden="true">+</span>
                </button>
                <div class="atelier-cart-gift__panel" id="CartGiftPanel-{{ section.id }}" hidden>
                  <p class="atelier-cart-gift__hint">{{ block.settings.hint }}</p>
                  <textarea
                    name="attributes[gift_note]"
                    form="cart"
                    class="atelier-cart-gift__textarea"
                    placeholder="{{ block.settings.placeholder }}"
                    maxlength="300"
                    rows="4"
                  >{{ cart.attributes.gift_note }}</textarea>
                  <label class="atelier-cart-gift__check">
                    <input
                      type="checkbox"
                      name="attributes[gift_no_prices]"
                      value="true"
                      form="cart"
                      {% if cart.attributes.gift_no_prices == 'true' %}checked{% endif %}
                    >
                    {{ block.settings.no_prices_label }}
                  </label>
                </div>
              </div>
            {%- when 'coupon_offer' -%}
              {%- if cart.cart_level_discount_applications.size == 0 -%}
                {%- liquid
                  assign min_amount = block.settings.minimum_amount
                  assign eligible = true
                  if min_amount > 0
                    assign cart_total = cart.total_price | divided_by: 100.0
                    if cart_total < min_amount
                      assign eligible = false
                      assign remaining = min_amount | minus: cart_total
                      assign remaining_money = remaining | times: 100 | money_without_trailing_zeros
                    endif
                  endif
                -%}
                <div class="atelier-coupon-offer{% if eligible %} is-eligible{% endif %}" {{ block.shopify_attributes }}>
                  <div class="atelier-coupon-offer__body">
                    <p class="atelier-coupon-offer__desc">{{ block.settings.description }}</p>
                    {%- if eligible -%}
                      <p class="atelier-coupon-offer__hint is-eligible">{{ block.settings.eligible_label }}</p>
                    {%- else -%}
                      <p class="atelier-coupon-offer__hint">{{ block.settings.locked_label }} {{ remaining_money }}</p>
                    {%- endif -%}
                    <span class="atelier-coupon-offer__code">{{ block.settings.code }}</span>
                  </div>
                  <button
                    type="button"
                    class="atelier-coupon-offer__apply"
                    data-atelier-coupon-offer-apply="{{ block.settings.code | escape }}"
                    {% unless eligible %}disabled{% endunless %}
                  >
                    {{ block.settings.apply_label }}
                  </button>
                </div>
              {%- endif -%}
              <script src="{{ 'atelier-coupon.js' | asset_url }}" defer="defer"></script>
            {%- when 'coupon' -%}
              <details class="atl-fold"{% if cart.cart_level_discount_applications.size > 0 %} open{% endif %}>
              <summary class="atl-fold__sum">Have a discount code?</summary>
              <div class="atelier-coupon" data-atelier-coupon {{ block.shopify_attributes }}>
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="atelier-coupon__applied list-unstyled" role="list">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li class="atelier-coupon__applied-item">
                        {{- 'icon-discount.svg' | inline_asset_content -}}
                        <span>{{ discount.title | escape }} applied (-{{ discount.total_allocated_amount | money_without_trailing_zeros }})</span>
                        <a href="{{ routes.root_url }}discount/?redirect={{ routes.cart_url | url_encode }}" class="atelier-coupon__remove">
                          {{ block.settings.remove_label }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <label class="atelier-coupon__label" for="CouponCode-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>
                  <div class="atelier-coupon__row">
                    <input
                      type="text"
                      id="CouponCode-{{ section.id }}"
                      class="atelier-coupon__input"
                      placeholder="{{ block.settings.placeholder }}"
                      autocapitalize="characters"
                      data-atelier-coupon-input
                    >
                    <button type="button" class="atelier-coupon__submit" data-atelier-coupon-submit>
                      {{ block.settings.apply_label }}
                    </button>
                  </div>
                  <small class="atelier-coupon__error" data-atelier-coupon-error hidden>{{ block.settings.error_label }}</small>
                {%- endif -%}
              </div>
              </details>
              <style>.atl-fold{margin:1rem 0}.atl-fold__sum{cursor:pointer;font-size:1.3rem;text-decoration:underline;text-underline-offset:.3rem;color:#14213d;list-style:none;padding:1rem 0;min-height:4.4rem;display:flex;align-items:center}.atl-fold__sum::-webkit-details-marker{display:none}</style>
              <script src="{{ 'atelier-coupon.js' | asset_url }}" defer="defer"></script>
            {%- when 'dispatch_note' -%}
              <p class="cart-dispatch-note caption-large rte" {{ block.shopify_attributes }}>
                <span class="svg-wrapper">{{- 'icon-truck.svg' | inline_asset_content -}}</span>
                {{ block.settings.text }}
              </p>
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <style>
                  .atl-sum{margin:0 0 1.4rem;padding:1.4rem 1.6rem;background:#f5f2eb;border:1px solid #d9d0c3;border-radius:.6rem;font-size:1.4rem;color:#14213d}
                  .atl-sum__eyebrow{font-size:1.1rem;letter-spacing:.14em;text-transform:uppercase;color:#a8371a;font-weight:700;margin:0 0 .6rem}
                  .atl-sum__row{display:flex;justify-content:space-between;gap:1.2rem;padding:.4rem 0}
                  .atl-sum__row--disc{color:#2f6b4f;font-weight:700}
                  .atl-sum__tot{display:flex;justify-content:space-between;align-items:baseline;margin-top:.6rem;padding-top:.9rem;border-top:1px solid #d9d0c3;font-weight:700;font-size:1.9rem}
                  .atl-sum__tag{display:block;width:fit-content;margin:1rem auto 0;padding:.35rem 1.1rem;background:#e3efe8;color:#2f6b4f;border-radius:10rem;font-weight:600;font-size:1.25rem}
                  .atl-sum__note{margin:.9rem 0 0;text-align:center;font-size:1.2rem;color:rgba(20,33,61,.7)}
                </style>
                <div class="atl-sum" role="group" aria-label="Order summary">
                  <p class="atl-sum__eyebrow">Order summary</p>
                  <div class="atl-sum__row"><span>Subtotal ({{ cart.item_count }} piece{% if cart.item_count != 1 %}s{% endif %})</span><span>{{ cart.original_total_price | money_without_trailing_zeros }}</span></div>
                  {%- if cart.total_discount > 0 -%}
                    {%- assign line_disc = 0 -%}
                    {%- assign line_title = '' -%}
                    {%- for item in cart.items -%}
                      {%- for alloc in item.line_level_discount_allocations -%}
                        {%- assign line_disc = line_disc | plus: alloc.amount -%}
                        {%- if line_title == '' -%}{%- assign line_title = alloc.discount_application.title -%}{%- endif -%}
                      {%- endfor -%}
                    {%- endfor -%}
                    {%- if line_disc > 0 -%}
                      {%- assign sum_pct = line_disc | times: 100.0 | divided_by: cart.original_total_price | round -%}
                      <div class="atl-sum__row atl-sum__row--disc"><span>{% if line_title contains 'Bundle' %}Bundle discount ({{ sum_pct }}% off all pieces){% else %}{{ line_title | escape }}{% endif %}</span><span>&minus; {{ line_disc | money_without_trailing_zeros }}</span></div>
                    {%- endif -%}
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <div class="atl-sum__row atl-sum__row--disc"><span>{{ discount.title | escape }}</span><span>&minus; {{ discount.total_allocated_amount | money_without_trailing_zeros }}</span></div>
                    {%- endfor -%}
                  {%- endif -%}
                  <div class="atl-sum__row"><span>Shipping</span><span>Free</span></div>
                  <div class="atl-sum__tot"><span>Total</span><span>{{ cart.total_price | money_without_trailing_zeros }}</span></div>
                  {%- if cart.total_discount > 0 -%}<span class="atl-sum__tag">You save {{ cart.total_discount | money_without_trailing_zeros }}</span>{%- endif -%}
                  <p class="atl-sum__note">{% if cart.taxes_included %}Inclusive of all taxes{% else %}GST calculated at checkout{% endif %}</p>
                </div>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
              </div>

              {%- liquid
                assign trust_lines = block.settings.checkout_trust_1 | append: '|' | append: block.settings.checkout_trust_2 | append: '|' | append: block.settings.checkout_trust_3 | split: '|'
              -%}
              {%- if block.settings.checkout_trust_1 != blank or block.settings.checkout_trust_2 != blank or block.settings.checkout_trust_3 != blank -%}
                <ul class="cart__checkout-trust list-unstyled" role="list">
                  {%- for line in trust_lines -%}
                    {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },    
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "hold_timer",
      "name": "Hold timer",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "duration_minutes",
          "label": "Hold duration (minutes)",
          "min": 10,
          "max": 60,
          "step": 5,
          "default": 30
        },
        {
          "type": "text",
          "id": "label",
          "label": "Active label",
          "default": "Items reserved for"
        },
        {
          "type": "text",
          "id": "expired_text",
          "label": "Expired label",
          "default": "Reservation expired — items may be released."
        }
      ]
    },
    {
      "type": "gift_note",
      "name": "Sending as a gift",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "toggle_label",
          "label": "Toggle label",
          "default": "Sending as a gift?"
        },
        {
          "type": "text",
          "id": "hint",
          "label": "Hint text",
          "default": "We'll write your note by hand, on card stock. No prices on the packing slip."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Textarea placeholder",
          "default": "Your message, up to 300 characters."
        },
        {
          "type": "text",
          "id": "no_prices_label",
          "label": "No-prices checkbox label",
          "default": "Please leave prices off the packing slip"
        }
      ]
    },
    {
      "type": "coupon_offer",
      "name": "Coupon offer",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Discount code",
          "info": "Must match a real active discount code in Shopify admin"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "70% off up to ₹140"
        },
        {
          "type": "number",
          "id": "minimum_amount",
          "label": "Minimum cart value to unlock (₹)",
          "info": "Leave blank or 0 for no minimum"
        },
        {
          "type": "text",
          "id": "eligible_label",
          "label": "Eligible message",
          "default": "Eligible — apply below"
        },
        {
          "type": "text",
          "id": "locked_label",
          "label": "Locked message prefix",
          "default": "Add items worth"
        },
        {
          "type": "text",
          "id": "apply_label",
          "label": "Apply button label",
          "default": "Apply"
        }
      ]
    },
    {
      "type": "coupon",
      "name": "Coupon code",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field label",
          "default": "Have a discount code?"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Input placeholder",
          "default": "Enter code"
        },
        {
          "type": "text",
          "id": "apply_label",
          "label": "Apply button label",
          "default": "Apply"
        },
        {
          "type": "text",
          "id": "remove_label",
          "label": "Remove link label",
          "default": "Remove"
        },
        {
          "type": "text",
          "id": "error_label",
          "label": "Invalid code message",
          "default": "That code didn't apply — check the spelling and try again."
        }
      ]
    },
    {
      "type": "dispatch_note",
      "name": "Delivery estimate",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Delivery estimate text",
          "default": "In stock · Ships in 2-4 business days"
        }
      ]
    },
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Trust signals near checkout"
        },
        {
          "type": "text",
          "id": "checkout_trust_1",
          "label": "Trust line 1",
          "default": "Secure payment"
        },
        {
          "type": "text",
          "id": "checkout_trust_2",
          "label": "Trust line 2",
          "default": "Easy 7-day returns"
        },
        {
          "type": "text",
          "id": "checkout_trust_3",
          "label": "Trust line 3",
          "default": "Ships in 2-4 days"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
