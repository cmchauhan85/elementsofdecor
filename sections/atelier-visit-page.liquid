<style>
.vp{padding:2.7rem 0 4rem;font-family:Assistant,sans-serif;color:#14213d}
.vp *{box-sizing:border-box}
.vp__in{max-width:110rem;margin:0 auto;padding:0 1.6rem}
@media(min-width:990px){.vp__in{padding:0}.vp{padding:4rem 0 6rem}}
.vp h1,.vp h2,.vp h3{font-family:Assistant,sans-serif;letter-spacing:0;color:#14213d;margin:0}
.vp__eye{margin:0 0 1rem;font-size:1.2rem;letter-spacing:.14em;text-transform:uppercase;color:#cf4a25}
.vp h1{font-weight:400;font-size:clamp(3rem,4.4vw,4.8rem);line-height:1.1}
.vp h1 em{font-style:italic;color:#cf4a25}
.vp__lead{margin:1.6rem 0 0;font-size:1.6rem;line-height:1.6;max-width:52ch;opacity:.85}
.vp__media span{display:block;overflow:hidden;border-radius:4px;background:#ece6da}
.vp__media img{width:100%;height:100%;object-fit:cover;display:block}
.vp__card{border:1px solid #d9d0c3;border-radius:4px;padding:2rem;display:grid;gap:1.6rem;background:rgba(255,255,255,.55)}
.vp__cell h3{font-size:1.2rem;font-weight:400;letter-spacing:.12em;text-transform:uppercase;color:#cf4a25;margin:0 0 .5rem}
.vp__cell p{margin:0;font-size:1.6rem;line-height:1.5}
.vp__act{display:flex;flex-wrap:wrap;gap:1rem}
.vp__btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 2.4rem;font-size:1.3rem;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;border-radius:4px;border:1px solid #14213d;color:#14213d}
.vp__btn--p{background:#cf4a25;border-color:#cf4a25;color:#fff}
.vp__find{margin-top:4rem;border-top:1px solid #d9d0c3;padding-top:3rem}
.vp__find h2{font-weight:400;font-size:clamp(2.4rem,3vw,3.2rem);margin-bottom:2rem}
.vp__items{display:grid;gap:2rem}
.vp__items h3{font-size:1.7rem;font-weight:600;margin:0 0 .4rem}
.vp__items p{margin:0;font-size:1.5rem;line-height:1.55;opacity:.85}
.vp__note{margin:3rem 0 0;font-size:1.5rem;opacity:.8}
@media(min-width:750px){.vp__items{grid-template-columns:repeat(3,1fr);gap:3rem}}
/* Layout: banner photo first, details beside two photos (decided 15 Oct 2026, option C) */
.vp__wrap{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.vp__media{display:contents}
.vp__m1{grid-column:1/-1;order:0;aspect-ratio:4/3}
.vp__copy{grid-column:1/-1;order:1;margin-top:1.2rem}
.vp__card{grid-column:1/-1;order:2}
.vp__m2,.vp__m3{order:3;aspect-ratio:1/1}
@media(min-width:750px){.vp__wrap{gap:2.4rem 4rem;align-items:start}.vp__m1{aspect-ratio:21/9}.vp__copy{grid-column:1;grid-row:2;margin-top:0}.vp__card{grid-column:1;grid-row:3}.vp__m2{grid-column:2;grid-row:2;aspect-ratio:16/10}.vp__m3{grid-column:2;grid-row:3;aspect-ratio:16/10}}
</style>
<div class='vp color-{{ section.settings.color_scheme }}' id='vp'>
  <div class='vp__in'>
    <div class='vp__wrap'>
      <div class='vp__copy'>
        <p class='vp__eye'>Experience Store</p>
        <h1>See the pieces, <em>in person.</em></h1>
        <p class='vp__lead'>Our store sits at the reception of Aranya Vilas in Udaipur, a glass-walled space where every piece catches the light. Come in, pick things up, feel the weight of the marble and the finish of the brass, and see how the elements sit together.</p>
      </div>
      <div class='vp__media'>
        {%- for i in (1..3) -%}
          {%- assign key = 'image_' | append: i -%}
          {%- assign im = section.settings[key] -%}
          <span class='vp__m{{ i }}'>{%- if im != blank -%}{{ im | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', alt: 'Elements of Decor Experience Store' }}{%- endif -%}</span>
        {%- endfor -%}
      </div>
      <div class='vp__card'>
        <div class='vp__cell'><h3>Hours</h3><p>{{ section.settings.hours }}</p></div>
        <div class='vp__cell'><h3>Find us</h3><p>{{ section.settings.address }}</p></div>
        <div class='vp__cell'><h3>Before you come</h3><p>Message us on WhatsApp to check a piece is in stock.</p></div>
        <div class='vp__act'>
          <a class='vp__btn vp__btn--p' href='{{ section.settings.maps_url }}' target='_blank' rel='noopener'>Get directions</a>
          <a class='vp__btn' href='https://wa.me/916353052025' target='_blank' rel='noopener'>WhatsApp us</a>
        </div>
      </div>
    </div>
    <div class='vp__find'>
      <h2>What you will find</h2>
      <div class='vp__items'>
        <div><h3>Stone, metal and more</h3><p>Our marble urlis, brass-finish vases, candle stands and the rest of the collection.</p></div>
        <div><h3>Pieces side by side</h3><p>See how the elements work together before you decide.</p></div>
        <div><h3>Gifts, ready to go</h3><p>Pick one up and take it home, in our kraft gift box.</p></div>
      </div>
      <p class='vp__note'>Can't make it? Everything in the store is also at elementsofdecor.com.</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Experience store page",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Photo 1 (large)" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "10 AM to 8 PM" },
    { "type": "text", "id": "address", "label": "Address", "default": "Aranya Vilas, Udaipur, Rajasthan" },
    { "type": "text", "id": "maps_url", "label": "Directions link", "default": "https://maps.app.goo.gl/6fPnhY2pFNfpELjz7" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [ { "name": "Experience store page" } ]
}
{% endschema %}
