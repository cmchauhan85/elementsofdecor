{{ 'section-atelier-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  case section.settings.height
    when 'small'
      assign h_desktop = 540
    when 'large'
      assign h_desktop = 860
    else
      assign h_desktop = 740
  endcase
-%}

<div
  class="atelier-hero color-{{ section.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  style="height: min(80vh, {{ h_desktop }}px);"
>
  {%- if section.settings.image != blank -%}
    <div class="atelier-hero__media">
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: fetch_priority,
          sizes: '100vw',
          widths: '550, 750, 1100, 1500, 2000, 3000',
          alt: section.settings.image.alt | default: section.settings.heading_line_1
      }}
    </div>
  {%- endif -%}

  <div class="atelier-hero__scrim"></div>

  <div class="atelier-hero__inner page-width">
    <div class="atelier-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        {% render 'atelier-eyebrow', text: section.settings.eyebrow, class: 'atelier-hero__eyebrow' %}
      {%- endif -%}
      <h1 class="atelier-hero__heading">
        {{ section.settings.heading_line_1 }}
        {%- if section.settings.heading_line_2 != blank -%}
          <em>{{ section.settings.heading_line_2 }}</em>
        {%- endif -%}
      </h1>
    </div>

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: '#' }}" class="atelier-hero__cta a-anim">
        <span>{{ section.settings.cta_label }}</span>
        <span class="atelier-hero__arrow a-round" aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Atelier hero",
  "tag": "section",
  "class": "atelier-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Manifesto · No. 01"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading — first line",
      "default": "Home is not styled."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading — second line (italic accent)",
      "default": "It is felt."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Read the manifesto"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Atelier hero"
    }
  ]
}
{% endschema %}
