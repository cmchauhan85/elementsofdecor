{{ 'section-atelier-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'atelier-shop-by.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign mode = 'element'
  if request.get.shop_by == 'object'
    assign mode = 'object'
  endif

  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign el_key  = section.settings.element_filter_key
  assign cat_key = section.settings.category_filter_key

  assign element_filter  = null
  assign category_filter = null

  for f in collection.filters
    if f.param_name == el_key
      assign element_filter = f
    elsif f.param_name == cat_key
      assign category_filter = f
    endif
  endfor

  assign per_page = section.settings.products_per_page

  assign active_label = null
  if mode == 'element' and element_filter
    for v in element_filter.active_values
      assign active_label = v.label
    endfor
  elsif mode == 'object' and category_filter
    for v in category_filter.active_values
      assign active_label = v.label
    endfor
  endif

  assign active_count = 0
  for f in collection.filters
    assign active_count = active_count | plus: f.active_values.size
  endfor
-%}

<div class="atelier-plp color-{{ section.settings.color_scheme }} a-section">
  <div class="page-width">

    {%- if section.settings.show_breadcrumb -%}
      <nav class="atelier-plp__crumb" aria-label="breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a>
        <span aria-hidden="true"> / </span>
        <span>{{ collection.title }}</span>
      </nav>
    {%- endif -%}

    <h1 class="atelier-plp__head">
      {%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ collection.title }}{%- endif -%}
    </h1>

    {%- comment %} Shop By band {% endcomment -%}
    <div class="atelier-plp__band">
      <div class="atelier-plp__band-left">
        {% render 'atelier-shop-by-switch', mode: mode, base_url: collection.url %}
        <span class="atelier-browse__caption" data-mode-when="element" {% if mode != 'element' %}hidden{% endif %}>{{ section.settings.element_caption }}</span>
        <span class="atelier-browse__caption" data-mode-when="object" {% if mode != 'object' %}hidden{% endif %}>{{ section.settings.object_caption }}</span>
      </div>
      {%- liquid
        if mode == 'object'
          assign band_status = section.settings.object_status_text
        else
          assign band_status = section.settings.element_status_text
        endif
      -%}
      {%- if band_status != blank -%}
        <div class="atelier-browse__status">
          <span class="atelier-browse__rule" aria-hidden="true"></span>
          <span class="atelier-browse__caption">{{ band_status }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- comment %} Filter bar: scrollable chip rail + sort {% endcomment -%}
    <div class="atelier-plp__filter-bar">
      {%- assign chip_modes = 'element,object' | split: ',' -%}
      {%- for m in chip_modes -%}
        {%- if m == 'element' -%}{%- assign chip_filter = element_filter -%}{%- else -%}{%- assign chip_filter = category_filter -%}{%- endif -%}
        <div class="atelier-plp__chips a-rail" data-mode-grid="{{ m }}" {% if mode != m %}hidden{% endif %}>
          <a href="{{ collection.url }}?shop_by={{ m }}" class="atelier-chip{% unless chip_filter.active_values.size > 0 %} is-active{% endunless %}">
            {{ 'products.facets.all' | t | default: 'All' }}<span class="atelier-chip__count">{{ collection.all_products_count }}</span>
          </a>
          {%- if chip_filter -%}
            {%- for value in chip_filter.values -%}
              <a
                href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                class="atelier-chip{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-soon{% endif %}"
              >{{ value.label }}<span class="atelier-chip__count">{{ value.count }}</span></a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}

      <form class="atelier-plp__sort" method="get" action="{{ collection.url }}">
        {%- if request.get.shop_by != blank -%}
          <input type="hidden" name="shop_by" value="{{ request.get.shop_by }}">
        {%- endif -%}
        {%- for f in collection.filters -%}
          {%- for v in f.active_values -%}
            <input type="hidden" name="{{ f.param_name }}" value="{{ v.value }}">
          {%- endfor -%}
        {%- endfor -%}
        <label class="atelier-plp__sort-label">
          <span class="atelier-plp__sort-prefix">Sort:</span>
          <select class="atelier-plp__sort-select" name="sort_by" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </label>
      </form>
    </div>

    {%- comment %} Mobile REFINE button — shown only below 990 px {% endcomment -%}
    <div class="atelier-plp__mobilebar">
      <button class="atelier-plp__refine-btn" id="atelier-refine-btn" aria-controls="atelier-sidebar" aria-expanded="false">
        <span aria-hidden="true">≡</span>
        {{ section.settings.refine_label | default: 'Refine' }}
        {%- if active_count > 0 -%}
          <span class="atelier-plp__refine-count">{{ active_count }}</span>
        {%- endif -%}
      </button>
    </div>

    {%- comment %} Body: sidebar column + product grid {% endcomment -%}
    <div class="atelier-plp__body">

      <aside class="atelier-plp__sidebar" id="atelier-sidebar">
        <div class="atelier-plp__sidebar-head">
          {% render 'atelier-eyebrow', text: 'Discover' %}
          <button class="atelier-plp__sidebar-close" id="atelier-sidebar-close" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">✕</button>
        </div>

        {%- assign el_menu  = section.settings.element_nav_menu -%}
        {%- assign obj_menu = section.settings.object_nav_menu -%}

        {%- if el_menu != blank -%}
          <div class="atelier-plp__nav-group">
            {% render 'atelier-eyebrow', text: section.settings.element_nav_label %}
            <ul class="atelier-plp__nav-list">
              {%- for link in linklists[el_menu].links -%}
                {%- assign link_handle = link.url | split: '/collections/' | last -%}
                {%- assign is_current = false -%}
                {%- if link_handle == collection.handle -%}{%- assign is_current = true -%}{%- endif -%}
                <li>
                  <a href="{{ link.url }}"
                     class="atelier-plp__nav-link{% if is_current %} is-current{% endif %}"
                     {% if is_current %}aria-current="page"{% endif %}>
                    <span>{{ link.title }}</span>
                    {%- if is_current -%}<span class="atelier-plp__nav-arrow" aria-hidden="true">→</span>{%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if obj_menu != blank -%}
          <div class="atelier-plp__nav-group">
            {% render 'atelier-eyebrow', text: section.settings.object_nav_label %}
            <ul class="atelier-plp__nav-list">
              {%- for link in linklists[obj_menu].links -%}
                {%- assign link_handle = link.url | split: '/collections/' | last -%}
                {%- assign is_current = false -%}
                {%- if link_handle == collection.handle -%}{%- assign is_current = true -%}{%- endif -%}
                <li>
                  <a href="{{ link.url }}"
                     class="atelier-plp__nav-link{% if is_current %} is-current{% endif %}"
                     {% if is_current %}aria-current="page"{% endif %}>
                    <span>{{ link.title }}</span>
                    {%- if is_current -%}<span class="atelier-plp__nav-arrow" aria-hidden="true">→</span>{%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.show_price_filter -%}
          {%- for f in collection.filters -%}
            {%- if f.type == 'price_range' -%}
              {% render 'atelier-facet-group', filter: f %}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </aside>

      <div class="atelier-plp__main">
        {%- paginate collection.products by per_page -%}

          {%- assign showing = paginate.current_offset | plus: collection.products.size -%}
          <div class="atelier-plp__grid-head">
            {%- if active_label != blank -%}
              <span class="atelier-plp__active-label">{{ active_label }}.</span>
            {%- else -%}
              <span></span>
            {%- endif -%}
            <span class="atelier-plp__count">Showing {{ showing }} of {{ paginate.items }}</span>
          </div>

          <div class="atelier-plp__grid">
            {%- for product in collection.products -%}
              {%- assign num = forloop.index | prepend: '0' | slice: -2, 2 -%}
              {% render 'atelier-product-card', product: product, number: num %}

              {%- if section.settings.editorial_after > 0 and forloop.index == section.settings.editorial_after and section.settings.editorial_title != blank -%}
                <div class="atelier-plp__editorial">
                  <div class="atelier-plp__editorial-body">
                    {% render 'atelier-eyebrow', text: section.settings.editorial_eyebrow, ochre: true %}
                    <p class="atelier-plp__editorial-title">{{ section.settings.editorial_title }}</p>
                    {%- if section.settings.editorial_link != blank -%}
                      <a href="{{ section.settings.editorial_link }}" class="atelier-plp__editorial-cta">{{ section.settings.editorial_cta }}</a>
                    {%- endif -%}
                  </div>
                  {%- if section.settings.editorial_image != blank -%}
                    <div class="atelier-plp__editorial-media">
                      {{
                        section.settings.editorial_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800',
                          alt: section.settings.editorial_title | escape
                      }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- else -%}
              <p>{{ 'sections.collection_template.empty' | t }}</p>
            {%- endfor -%}
          </div>

          <div class="atelier-plp__more">
            {%- if paginate.next.is_link -%}
              <a href="{{ paginate.next.url }}" class="button">{{ section.settings.more_label }}</a>
            {%- else -%}
              <p>{{ section.settings.end_label }}</p>
            {%- endif -%}
          </div>

        {%- endpaginate -%}
      </div>

    </div>
  </div>
</div>

<div class="atelier-plp__overlay" id="atelier-overlay" aria-hidden="true"></div>

<script>
  (() => {
    const sidebar = document.getElementById('atelier-sidebar');
    const overlay = document.getElementById('atelier-overlay');
    const openBtn = document.getElementById('atelier-refine-btn');
    const closeBtn = document.getElementById('atelier-sidebar-close');
    if (!sidebar || !openBtn) return;
    function openSidebar() {
      sidebar.classList.add('is-open');
      overlay.classList.add('is-open');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('is-open');
      overlay.classList.remove('is-open');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    openBtn.addEventListener('click', openSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    overlay.addEventListener('click', closeSidebar);
  })();
</script>

{% schema %}
{
  "name": "Atelier collection",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (blank = collection title)",
      "default": "Stone and Metal. <em>Eleven pieces, in the room now.</em>"
    },
    {
      "type": "header",
      "content": "Shop By band"
    },
    {
      "type": "text",
      "id": "element_caption",
      "label": "Caption — Element mode",
      "default": "By material – the way we make them."
    },
    {
      "type": "text",
      "id": "object_caption",
      "label": "Caption — Object mode",
      "default": "By what it is – the familiar way to shop."
    },
    {
      "type": "text",
      "id": "element_status_text",
      "label": "Status text — Element mode",
      "info": "Right-side label in the band, e.g. \"FIVE MATERIALS\"",
      "default": "FIVE MATERIALS"
    },
    {
      "type": "text",
      "id": "object_status_text",
      "label": "Status text — Object mode",
      "default": "FIVE OBJECTS"
    },
    {
      "type": "header",
      "content": "Discovery sidebar"
    },
    {
      "type": "link_list",
      "id": "element_nav_menu",
      "label": "Element navigation menu",
      "info": "Create a menu in Online Store › Navigation with links to all element collections (Stone, Metal, Ceramic, Wood, Fabric)."
    },
    {
      "type": "text",
      "id": "element_nav_label",
      "label": "Element group heading",
      "default": "By Element"
    },
    {
      "type": "link_list",
      "id": "object_nav_menu",
      "label": "Object navigation menu",
      "info": "Create a menu in Online Store › Navigation with links to all object collections (Urlis & Bowls, Vases, etc.)."
    },
    {
      "type": "text",
      "id": "object_nav_label",
      "label": "Object group heading",
      "default": "By Object"
    },
    {
      "type": "checkbox",
      "id": "show_price_filter",
      "label": "Show price filter below nav",
      "default": false
    },
    {
      "type": "header",
      "content": "Filters (legacy — for metafield chips)"
    },
    {
      "type": "text",
      "id": "element_filter_key",
      "label": "Element filter param",
      "info": "The storefront filter param for the material axis.",
      "default": "filter.p.m.atelier.element"
    },
    {
      "type": "text",
      "id": "category_filter_key",
      "label": "Category filter param",
      "info": "The storefront filter param for the object/category axis.",
      "default": "filter.p.m.atelier.category"
    },
    {
      "type": "text",
      "id": "refine_label",
      "label": "Mobile Discover button label",
      "default": "Discover"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 2,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Load-more label",
      "default": "Show the next twelve"
    },
    {
      "type": "text",
      "id": "end_label",
      "label": "End-of-shop label",
      "default": "That's the full shop — for now."
    },
    {
      "type": "header",
      "content": "Inline editorial slot"
    },
    {
      "type": "range",
      "id": "editorial_after",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Insert after product #",
      "info": "0 disables the slot."
    },
    {
      "type": "text",
      "id": "editorial_eyebrow",
      "label": "Editorial eyebrow",
      "default": "Field note"
    },
    {
      "type": "text",
      "id": "editorial_title",
      "label": "Editorial title",
      "default": "Where the brass is folded by hand."
    },
    {
      "type": "text",
      "id": "editorial_cta",
      "label": "Editorial link label",
      "default": "Read the note →"
    },
    {
      "type": "url",
      "id": "editorial_link",
      "label": "Editorial link"
    },
    {
      "type": "image_picker",
      "id": "editorial_image",
      "label": "Editorial image",
      "info": "Appears on the right half of the editorial card."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
