{{ 'section-atelier-contact.css' | asset_url | stylesheet_tag }}

<div class="atelier-contact color-{{ section.settings.color_scheme }} a-section">
  <div class="page-width">
    <div class="atelier-contact__grid">

      <div class="atelier-contact__intro">
        <h1 class="atelier-contact__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.subtext != blank -%}
          <p class="atelier-contact__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="atelier-contact__channels">
            {%- for block in section.blocks -%}
              {%- if block.type == 'channel' -%}
                <div class="atelier-contact__channel" {{ block.shopify_attributes }}>
                  <span class="atelier-contact__channel-label">{{ block.settings.label }}</span>
                  <span class="atelier-contact__channel-value">
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}">{{ block.settings.value }}</a>
                    {%- else -%}
                      {{ block.settings.value }}
                    {%- endif -%}
                    {%- if block.settings.note != blank -%}
                      <br><span class="atelier-contact__channel-note">{{ block.settings.note }}</span>
                    {%- endif -%}
                  </span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="atelier-contact__form-col">
        {%- liquid
          assign contact_form_class = 'atelier-contact__form isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = contact_form_class | append: ' scroll-trigger animate--slide-in'
          endif
        -%}
        {%- form 'contact', id: 'AtelierContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- else -%}
            {%- if form.errors -%}
              <div class="form__message">
                <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                  {{- 'icon-error.svg' | inline_asset_content -}}
                  {{ 'templates.contact.form.error_heading' | t }}
                </h2>
              </div>
              <ul class="form-status-list caption-large" role="list">
                <li>
                  <a href="#AtelierContactForm-email" class="link">
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </a>
                </li>
              </ul>
            {%- endif -%}
            <div class="contact__fields">
              <div class="field">
                <input
                  class="field__input"
                  autocomplete="name"
                  type="text"
                  id="AtelierContactForm-name"
                  name="contact[{{ 'templates.contact.form.name' | t }}]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.name' | t }}"
                >
                <label class="field__label" for="AtelierContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
              </div>
              <div class="field field--with-error">
                <input
                  autocomplete="email"
                  type="email"
                  id="AtelierContactForm-email"
                  class="field__input"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="AtelierContactForm-email-error"
                  {% endif %}
                  placeholder="{{ 'templates.contact.form.email' | t }}"
                >
                <label class="field__label" for="AtelierContactForm-email">
                  {{- 'templates.contact.form.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'email' -%}
                  <small class="contact__field-error" id="AtelierContactForm-email-error">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </span>
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field">
              <input
                type="text"
                id="AtelierContactForm-subject"
                class="field__input"
                name="contact[{{ section.settings.subject_field_label | default: 'Subject' }}]"
                placeholder="{{ section.settings.subject_field_label | default: 'Subject' }}"
              >
              <label class="field__label" for="AtelierContactForm-subject">{{ section.settings.subject_field_label | default: 'Subject' }}</label>
            </div>
            <div class="field">
              <textarea
                rows="8"
                id="AtelierContactForm-body"
                class="text-area field__input"
                name="contact[{{ 'templates.contact.form.comment' | t }}]"
                placeholder="{{ 'templates.contact.form.comment' | t }}"
              >{{- form.body -}}</textarea>
              <label class="form__label field__label" for="AtelierContactForm-body">
                {{- 'templates.contact.form.comment' | t -}}
              </label>
            </div>
            <div class="contact__button">
              <button type="submit" class="button">
                {{ 'templates.contact.form.send' | t }}
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atelier contact",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get in <em>touch.</em>"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Questions about an order, a product, or a material? We reply within one working day."
    },
    {
      "type": "text",
      "id": "subject_field_label",
      "label": "Form \"subject\" field label",
      "default": "Subject"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Contact channel",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "value", "label": "Value", "default": "hello@example.com" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional — e.g. mailto:, tel:, or https:// link. Leave blank for plain text." },
        { "type": "text", "id": "note", "label": "Note", "info": "Optional second line, e.g. \"By appointment only\"" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier contact",
      "blocks": [
        { "type": "channel", "settings": { "label": "Email", "value": "hello@elementsofdecor.in", "link": "mailto:hello@elementsofdecor.in" } },
        { "type": "channel", "settings": { "label": "WhatsApp", "value": "+91 63530 52025" } },
        { "type": "channel", "settings": { "label": "Instagram", "value": "@elementsofdecor" } },
        { "type": "channel", "settings": { "label": "Hours", "value": "Mon–Sat, 10am–6pm IST" } }
      ]
    }
  ]
}
{% endschema %}
