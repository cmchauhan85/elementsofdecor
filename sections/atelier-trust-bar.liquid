{{ 'section-atelier-trust-bar.css' | asset_url | stylesheet_tag }}

{%- if section.settings.style == 'marquee' -%}
  <div class="atelier-trust-bar atelier-trust-bar--marquee color-{{ section.settings.color_scheme }}">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="page-width">
        <div class="atelier-block__head">
          {%- if section.settings.eyebrow != blank -%}
            {% render 'atelier-eyebrow', text: section.settings.eyebrow %}
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="atelier-block__title">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <div class="atelier-trust-bar__marquee-wrap" aria-hidden="true">
      <div class="atelier-trust-bar__track">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' and block.settings.label != blank -%}
              <span class="atelier-trust-bar__marquee-item">
                <span class="atelier-trust-bar__marquee-dot" aria-hidden="true"></span>{{ block.settings.label }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    <span class="visually-hidden">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' and block.settings.label != blank -%}{{ block.settings.label }}. {%- endif -%}
      {%- endfor -%}
    </span>
  </div>
{%- else -%}
  <div class="atelier-trust-bar color-{{ section.settings.color_scheme }} a-section">
    <div class="page-width">
      {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
        <div class="atelier-block__head">
          {%- if section.settings.eyebrow != blank -%}
            {% render 'atelier-eyebrow', text: section.settings.eyebrow %}
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="atelier-block__title">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="atelier-trust-bar__grid list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <li
              class="atelier-trust-bar__item{% if block.settings.hide_on_mobile %} atelier-trust-bar__item--desktop-only{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- render 'icon-accordion', icon: block.settings.icon -%}
              <div class="atelier-trust-bar__copy">
                <strong class="atelier-trust-bar__label">{{ block.settings.label }}</strong>
                {%- if block.settings.subtext != blank -%}
                  <span class="atelier-trust-bar__subtext">{{ block.settings.subtext }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "badges", "label": "Badges (icon + label)" },
        { "value": "marquee", "label": "Scrolling marquee (text only)" }
      ],
      "default": "badges"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Leave blank to hide"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "info": "Leave blank to hide"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "check_mark", "label": "Checkmark" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "box", "label": "Box" },
            { "value": "star", "label": "Star" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "heart", "label": "Heart" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "question_mark", "label": "Question mark" }
          ],
          "default": "check_mark"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Trust claim"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "info": "Optional, shown beneath the label"
        },
        {
          "type": "checkbox",
          "id": "hide_on_mobile",
          "label": "Hide on mobile",
          "info": "Use for the least essential badge(s) so the mobile strip fits without scrolling",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "label": "Free shipping", "subtext": "On every order" } },
        { "type": "badge", "settings": { "icon": "return", "label": "Easy 7-day returns", "subtext": "No questions asked" } },
        { "type": "badge", "settings": { "icon": "lock", "label": "Secured by Razorpay", "subtext": "100% protected payments", "hide_on_mobile": true } },
        { "type": "badge", "settings": { "icon": "leaf", "label": "Handmade, naturally varied", "subtext": "Wood grain, stone veining, and finish differ slightly piece to piece" } }
      ]
    }
  ]
}
{% endschema %}
