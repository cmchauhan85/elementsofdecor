{%- comment -%} TEMPORARY mockup (19 Oct 2026): three looks for the Imber ceramic banner, switched by a fixed bar at the bottom (lifted above Shopify's own preview bar). Delete this section and templates/index.banner-mock.json after the decision. {%- endcomment -%}
{%- assign bm_title_a = section.settings.title | replace: 'Hand-carved', '<span style="white-space:nowrap">Hand-carved</span>' -%}
{%- assign bm_title_b = section.settings.title | replace: 'Hand-carved', '<em style="white-space:nowrap">Hand-carved</em>' -%}
<style>
#bm-{{ section.id }} .bm-opt[hidden]{display:none}
#bm-{{ section.id }} .bm-in{display:grid;grid-template-columns:1fr}
#bm-{{ section.id }} .bm-media{margin:0;order:-1;aspect-ratio:5/4;min-width:0;background:#e6dccf}
#bm-{{ section.id }} .bm-media img{width:100%;height:100%;object-fit:cover;display:block}
#bm-{{ section.id }} .bm-txt{min-width:0;display:flex;flex-direction:column;justify-content:center}

/* A: current banner, unchanged */
#bm-{{ section.id }} .bm-a{background:#f5f2eb;color:#14213d;overflow:hidden}
#bm-{{ section.id }} .bm-a .bm-txt{padding:2.8rem 2.2rem 3.2rem;align-items:flex-start}
#bm-{{ section.id }} .bm-a .bm-eye{font-size:1.2rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:#a8371a;margin:0 0 1rem}
#bm-{{ section.id }} .bm-a .bm-ttl{font-family:var(--font-heading-family);font-weight:500;font-size:clamp(3.2rem,9vw,4.2rem);line-height:1.04;margin:0 0 1.2rem;text-wrap:balance;color:#14213d}
#bm-{{ section.id }} .bm-a .bm-p{font-size:1.6rem;line-height:1.55;margin:0 0 2.2rem;max-width:36ch;color:#3b4560}
#bm-{{ section.id }} .bm-a .bm-cta{display:inline-flex;align-items:center;min-height:4.4rem;background:#14213d;color:#fff;text-decoration:none;font-weight:700;font-size:1.4rem;letter-spacing:.06em;padding:1.2rem 2.4rem;border-radius:2px}

/* B and C: typography and colours of the Experience Store / Gifting band */
#bm-{{ section.id }} .bm-b,#bm-{{ section.id }} .bm-c{overflow:hidden}
#bm-{{ section.id }} .bm-b .bm-txt,#bm-{{ section.id }} .bm-c .bm-txt{padding:3rem 2.2rem 3.4rem;align-items:center;text-align:center}
#bm-{{ section.id }} .bm-b .bm-eye,#bm-{{ section.id }} .bm-c .bm-eye{font-size:1.2rem;letter-spacing:.22em;text-transform:uppercase;color:var(--a-ochre,#cf4a25);margin:0 0 1.2rem}
#bm-{{ section.id }} .bm-b .bm-ttl,#bm-{{ section.id }} .bm-c .bm-ttl{font-family:var(--font-heading-family);font-weight:400;font-size:clamp(2.6rem,7vw,4.2rem);line-height:1.12;margin:0;text-wrap:balance}
#bm-{{ section.id }} .bm-b .bm-ttl em,#bm-{{ section.id }} .bm-c .bm-ttl em{color:var(--a-ochre,#cf4a25);font-style:italic}
#bm-{{ section.id }} .bm-rule{display:block;width:4rem;height:2px;background:var(--a-ochre,#cf4a25);margin:1.8rem auto}
#bm-{{ section.id }} .bm-b .bm-p,#bm-{{ section.id }} .bm-c .bm-p{color:var(--a-muted,rgba(var(--color-foreground),.7));font-size:1.5rem;line-height:1.7;margin:0 auto 2.2rem;max-width:46ch}
#bm-{{ section.id }} .bm-b .bm-cta,#bm-{{ section.id }} .bm-c .bm-cta{display:inline-flex;align-items:center;justify-content:center;min-height:4.4rem;border:1px solid var(--a-ink,#14213d);padding:1.2rem 2.6rem;font-size:1.2rem;letter-spacing:.18em;text-transform:uppercase;text-decoration:none;color:inherit;transition:background .2s,color .2s,border-color .2s}
#bm-{{ section.id }} .bm-b .bm-cta:hover{background:var(--a-ink,#14213d);color:#fff}
#bm-{{ section.id }} .bm-c .bm-cta{background:var(--a-ink,#14213d);color:#fff}
#bm-{{ section.id }} .bm-c .bm-cta:hover{background:#a8371a;border-color:#a8371a}

@media(min-width:750px){
#bm-{{ section.id }} .bm-in{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);min-height:48rem}
#bm-{{ section.id }} .bm-media{order:0;aspect-ratio:auto}
#bm-{{ section.id }} .bm-a .bm-txt{padding:5rem clamp(3rem,5vw,8rem)}
#bm-{{ section.id }} .bm-a .bm-ttl{font-size:clamp(4rem,4.6vw,5.6rem)}
#bm-{{ section.id }} .bm-a .bm-p{font-size:1.8rem}
#bm-{{ section.id }} .bm-b .bm-txt,#bm-{{ section.id }} .bm-c .bm-txt{padding:5rem clamp(3rem,5vw,8rem);align-items:flex-start;text-align:left}
#bm-{{ section.id }} .bm-b .bm-ttl,#bm-{{ section.id }} .bm-c .bm-ttl{font-size:clamp(3.2rem,3.6vw,4.2rem)}
#bm-{{ section.id }} .bm-rule{margin:2rem 0}
#bm-{{ section.id }} .bm-b .bm-p,#bm-{{ section.id }} .bm-c .bm-p{margin-inline:0}
}

/* selector bar (mockup only); bottom offset keeps it above Shopify's preview bar */
.bm-bar{position:fixed;left:0;right:0;bottom:6.4rem;z-index:2000;background:#14213d;color:#fff;padding:.9rem max(1.6rem,env(safe-area-inset-right,0px)) .9rem max(1.6rem,env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:.8rem;box-shadow:0 -2px 12px rgba(0,0,0,.25)}
.bm-note{margin:0;font-size:1.3rem;line-height:1.4;color:#d9d0c3;min-height:3.6rem}
.bm-btns{display:flex;gap:.8rem}
.bm-btn{flex:1 1 0;min-height:4.4rem;border:1px solid rgba(255,255,255,.35);background:transparent;color:#fff;font:inherit;font-size:1.3rem;font-weight:600;cursor:pointer;border-radius:.4rem;padding:.6rem .8rem}
.bm-btn.is-on{background:#cf4a25;border-color:#cf4a25}
.bm-btn:focus-visible{outline:2px solid #fff;outline-offset:2px}
body{padding-bottom:22rem}
</style>
<section id="bm-{{ section.id }}" aria-label="Banner mockup">
  {%- comment -%}A: current{%- endcomment -%}
  <div class="bm-opt bm-a" data-opt="a">
    <div class="bm-in">
      <div class="bm-txt">
        <p class="bm-eye">{{ section.settings.eyebrow }}</p>
        <h2 class="bm-ttl">{{ bm_title_a }}</h2>
        <p class="bm-p">{{ section.settings.text }}</p>
        <a class="bm-cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      </div>
      <figure class="bm-media">{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 52vw, 100vw', alt: section.settings.image_alt }}</figure>
    </div>
  </div>
  {%- comment -%}B: match store band, outlined button{%- endcomment -%}
  <div class="bm-opt bm-b color-scheme-2 gradient" data-opt="b" hidden>
    <div class="bm-in">
      <div class="bm-txt">
        <p class="bm-eye">{{ section.settings.eyebrow }}</p>
        <h2 class="bm-ttl">{{ bm_title_b }}</h2>
        <span class="bm-rule"></span>
        <p class="bm-p">{{ section.settings.text }}</p>
        <a class="bm-cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      </div>
      <figure class="bm-media">{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 52vw, 100vw', alt: section.settings.image_alt }}</figure>
    </div>
  </div>
  {%- comment -%}C: match store band, solid button{%- endcomment -%}
  <div class="bm-opt bm-c color-scheme-2 gradient" data-opt="c" hidden>
    <div class="bm-in">
      <div class="bm-txt">
        <p class="bm-eye">{{ section.settings.eyebrow }}</p>
        <h2 class="bm-ttl">{{ bm_title_b }}</h2>
        <span class="bm-rule"></span>
        <p class="bm-p">{{ section.settings.text }}</p>
        <a class="bm-cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      </div>
      <figure class="bm-media">{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 52vw, 100vw', alt: section.settings.image_alt }}</figure>
    </div>
  </div>
  <div class="bm-bar" role="group" aria-label="Banner options">
    <p class="bm-note" aria-live="polite"></p>
    <div class="bm-btns">
      <button type="button" class="bm-btn" data-opt="a">A. Current</button>
      <button type="button" class="bm-btn" data-opt="b">B. Match store band</button>
      <button type="button" class="bm-btn" data-opt="c">C. Match + solid button</button>
    </div>
  </div>
</section>
<script>
(function(){
  var root=document.getElementById('bm-{{ section.id }}'); if(!root) return;
  var opts=root.querySelectorAll('.bm-opt'), btns=root.querySelectorAll('.bm-btn'), note=root.querySelector('.bm-note');
  var notes={
    a:"Today's banner: bold headline, solid navy button, fixed colours. Text left-aligned on phone.",
    b:"Same look as the Experience Store band: regular headline with a coral italic accent, coral rule, outlined uppercase button, text centred on phone.",
    c:"As B, but the button stays solid navy so the main action stands out more."
  };
  function show(k){
    [].forEach.call(opts,function(o){o.hidden=(o.getAttribute('data-opt')!==k)});
    [].forEach.call(btns,function(b){var on=b.getAttribute('data-opt')===k;b.classList.toggle('is-on',on);b.setAttribute('aria-pressed',on?'true':'false')});
    note.textContent=notes[k];
  }
  [].forEach.call(btns,function(b){b.addEventListener('click',function(){show(b.getAttribute('data-opt'))})});
  show('a');
  function jump(){ root.scrollIntoView({block:'start'}); }
  if(!location.hash){ window.addEventListener('load',function(){setTimeout(jump,400)}); }
})();
</script>
{% schema %}
{
  "name": "Banner mockup",
  "settings": [
    {"type":"image_picker","id":"image","label":"Photo"},
    {"type":"text","id":"image_alt","label":"Photo description"},
    {"type":"text","id":"eyebrow","label":"Eyebrow"},
    {"type":"inline_richtext","id":"title","label":"Headline"},
    {"type":"textarea","id":"text","label":"Text"},
    {"type":"text","id":"cta_label","label":"Button label"},
    {"type":"url","id":"link","label":"Button link"}
  ],
  "presets": [{"name":"Banner mockup"}]
}
{% endschema %}
