{{ 'section-atelier-browse.css' | asset_url | stylesheet_tag }}
<script src="{{ 'atelier-shop-by.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign req_mode = 'element'
  if request.get.shop_by == 'object'
    assign req_mode = 'object'
  endif
-%}

<div class="atelier-browse color-{{ section.settings.color_scheme }} a-section">
  <div class="page-width">
    {%- if section.settings.mobile_intro != blank -%}
      <div class="atelier-browse__mobile-intro">
        <span class="atelier-browse__mobile-intro-label">{{ section.settings.mobile_intro_label }}</span>
        <p class="atelier-browse__mobile-intro-copy">{{ section.settings.mobile_intro }}</p>
      </div>
    {%- endif -%}
    <div class="atelier-browse__head">
      <div class="atelier-browse__lead">
        {% render 'atelier-shop-by-switch',
          mode: req_mode,
          base_url: request.path,
          lead: section.settings.lead,
          element_label: section.settings.element_label,
          object_label: section.settings.object_label
        %}
        <span class="atelier-browse__caption" data-mode-when="element" {% if req_mode != 'element' %}hidden{% endif %}>
          {{ section.settings.element_caption }}
        </span>
        <span class="atelier-browse__caption" data-mode-when="object" {% if req_mode != 'object' %}hidden{% endif %}>
          {{ section.settings.object_caption }}
        </span>
      </div>

      {%- liquid
        if req_mode == 'object'
          assign active_status = section.settings.object_status_text
        else
          assign active_status = section.settings.element_status_text
        endif
      -%}
      {%- if active_status != blank -%}
        <div class="atelier-browse__status">
          <span class="atelier-browse__rule" aria-hidden="true"></span>
          <span class="atelier-browse__caption">{{ active_status }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- assign browse_modes = 'element,object' | split: ',' -%}
    {%- for mode in browse_modes -%}
      <div class="atelier-browse__grid" data-mode-grid="{{ mode }}" {% if req_mode != mode %}hidden{% endif %}>
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.mode == mode and block.settings.collection != blank -%}
            {%- assign n = n | plus: 1 -%}
            {%- assign num = n | prepend: '0' | slice: -2, 2 -%}
            <div {{ block.shopify_attributes }}>
              {% render 'atelier-collection-card',
                collection: block.settings.collection,
                number: num,
                show_element: block.settings.show_element,
                title_override: block.settings.title_override
              %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- liquid
        if mode == 'element'
          assign view_all_url = section.settings.element_view_all_url | default: '/collections/all'
          assign view_all_label = section.settings.element_view_all_label | default: 'View all elements →'
        else
          assign view_all_url = section.settings.object_view_all_url | default: '/collections/all'
          assign view_all_label = section.settings.object_view_all_label | default: 'View all objects →'
        endif
      -%}
      {%- if view_all_url != blank -%}
        <div class="atelier-browse__view-all" data-mode-grid="{{ mode }}" {% if req_mode != mode %}hidden{% endif %}>
          <a href="{{ view_all_url }}" class="atelier-browse__view-all-link">{{ view_all_label }}</a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Atelier Shop By band",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "mobile_intro_label",
      "label": "Mobile intro — label",
      "default": "THE SHOP",
      "info": "Shown only on mobile, above the browse toggle"
    },
    {
      "type": "text",
      "id": "mobile_intro",
      "label": "Mobile intro — tagline",
      "default": "Considered, not collected.",
      "info": "Leave blank to hide this intro block"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Lead label",
      "default": "Shop by"
    },
    {
      "type": "text",
      "id": "element_label",
      "label": "Element option label",
      "default": "Element"
    },
    {
      "type": "text",
      "id": "object_label",
      "label": "Object option label",
      "default": "Object"
    },
    {
      "type": "text",
      "id": "element_caption",
      "label": "Caption — Element mode",
      "default": "Five materials, each with its own voice."
    },
    {
      "type": "text",
      "id": "object_caption",
      "label": "Caption — Object mode",
      "default": "What it is, and what it holds."
    },
    {
      "type": "text",
      "id": "element_status_text",
      "label": "Status text — Element mode",
      "default": "TWO OF FIVE LIVE · THREE COMING SOON"
    },
    {
      "type": "text",
      "id": "object_status_text",
      "label": "Status text — Object mode",
      "default": "THREE OF FIVE LIVE · TWO COMING SOON"
    },
    {
      "type": "url",
      "id": "element_view_all_url",
      "label": "Element mode — View all URL",
      "info": "Leave blank to hide the link"
    },
    {
      "type": "text",
      "id": "element_view_all_label",
      "label": "Element mode — View all label",
      "default": "View all elements →"
    },
    {
      "type": "url",
      "id": "object_view_all_url",
      "label": "Object mode — View all URL",
      "info": "Leave blank to hide the link"
    },
    {
      "type": "text",
      "id": "object_view_all_label",
      "label": "Object mode — View all label",
      "default": "View all objects →"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "mode",
          "label": "Show in mode",
          "options": [
            { "value": "element", "label": "Element" },
            { "value": "object", "label": "Object" }
          ],
          "default": "element"
        },
        {
          "type": "checkbox",
          "id": "show_element",
          "label": "Show element tag (Object cards)",
          "default": false
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override",
          "info": "Leave blank to use the collection's own title. Useful when the same collection appears in both Element and Object mode under different names (e.g. \"Wax\" vs \"Candles\")."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier Shop By band",
      "blocks": [
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } }
      ]
    }
  ]
}
{% endschema %}
