{{ 'section-atelier-browse.css' | asset_url | stylesheet_tag }}
<script src="{{ 'atelier-shop-by.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign req_mode = 'element'
  if request.get.shop_by == 'object'
    assign req_mode = 'object'
  endif
-%}

<div class="atelier-browse color-{{ section.settings.color_scheme }} a-section">
  <div class="page-width">
    <div class="atelier-browse__head">
      <div class="atelier-browse__lead">
        {% render 'atelier-shop-by-switch',
          mode: req_mode,
          base_url: request.path,
          lead: section.settings.lead,
          element_label: section.settings.element_label,
          object_label: section.settings.object_label
        %}
        <span class="atelier-browse__caption" data-mode-when="element" {% if req_mode != 'element' %}hidden{% endif %}>
          {{ section.settings.element_caption }}
        </span>
        <span class="atelier-browse__caption" data-mode-when="object" {% if req_mode != 'object' %}hidden{% endif %}>
          {{ section.settings.object_caption }}
        </span>
      </div>

      {%- liquid
        if req_mode == 'object'
          assign active_status = section.settings.object_status_text
        else
          assign active_status = section.settings.element_status_text
        endif
      -%}
      {%- if active_status != blank -%}
        <div class="atelier-browse__status">
          <span class="atelier-browse__rule" aria-hidden="true"></span>
          <span class="atelier-browse__caption">{{ active_status }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- assign browse_modes = 'element,object' | split: ',' -%}
    {%- for mode in browse_modes -%}
      <div class="atelier-browse__grid" data-mode-grid="{{ mode }}" {% if req_mode != mode %}hidden{% endif %}>
        {%- liquid
          assign use_menu = false
          if mode == 'element' and section.settings.elements_menu != blank
            assign nav_links = linklists[section.settings.elements_menu].links
            if nav_links.size > 0
              assign use_menu = true
            endif
          elsif mode == 'object' and section.settings.objects_menu != blank
            assign nav_links = linklists[section.settings.objects_menu].links
            if nav_links.size > 0
              assign use_menu = true
            endif
          endif
        -%}
        {%- if use_menu -%}
          {%- assign n = 0 -%}
          {%- for nav_link in nav_links -%}
            {%- assign col_handle = nav_link.url | split: '/collections/' | last -%}
            {%- assign col = collections[col_handle] -%}
            {%- if col != blank -%}
              {%- assign n = n | plus: 1 -%}
              {%- assign num = n | prepend: '0' | slice: -2, 2 -%}
              <div>
                {% render 'atelier-collection-card',
                  collection: col,
                  number: num,
                  show_element: mode == 'object'
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.mode == mode and block.settings.collection != blank -%}
              {%- assign n = n | plus: 1 -%}
              {%- assign num = n | prepend: '0' | slice: -2, 2 -%}
              <div {{ block.shopify_attributes }}>
                {% render 'atelier-collection-card',
                  collection: block.settings.collection,
                  number: num,
                  show_element: block.settings.show_element
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Atelier Shop By band",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "lead",
      "label": "Lead label",
      "default": "Shop by"
    },
    {
      "type": "text",
      "id": "element_label",
      "label": "Element option label",
      "default": "Element"
    },
    {
      "type": "text",
      "id": "object_label",
      "label": "Object option label",
      "default": "Object"
    },
    {
      "type": "text",
      "id": "element_caption",
      "label": "Caption — Element mode",
      "default": "Five materials, each with its own voice."
    },
    {
      "type": "text",
      "id": "object_caption",
      "label": "Caption — Object mode",
      "default": "What it is, and what it holds."
    },
    {
      "type": "text",
      "id": "element_status_text",
      "label": "Status text — Element mode",
      "default": "TWO OF FIVE LIVE · THREE COMING SOON"
    },
    {
      "type": "text",
      "id": "object_status_text",
      "label": "Status text — Object mode",
      "default": "THREE OF FIVE LIVE · TWO COMING SOON"
    },
    {
      "type": "link_list",
      "id": "elements_menu",
      "default": "elements-menu",
      "label": "Elements menu (syncs with header)",
      "info": "When set, cards are driven by this navigation menu — the same menu the header dropdown reads from. Leave blank to use the blocks below instead."
    },
    {
      "type": "link_list",
      "id": "objects_menu",
      "default": "objects-menu",
      "label": "Objects menu (syncs with header)",
      "info": "When set, cards are driven by this navigation menu — the same menu the header dropdown reads from. Leave blank to use the blocks below instead."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "mode",
          "label": "Show in mode",
          "options": [
            { "value": "element", "label": "Element" },
            { "value": "object", "label": "Object" }
          ],
          "default": "element"
        },
        {
          "type": "checkbox",
          "id": "show_element",
          "label": "Show element tag (Object cards)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier Shop By band",
      "blocks": [
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "element" } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } },
        { "type": "card", "settings": { "mode": "object", "show_element": true } }
      ]
    }
  ]
}
{% endschema %}
