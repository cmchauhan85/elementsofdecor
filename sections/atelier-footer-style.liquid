{%- liquid
  comment
    Stock map for the quantity cap (15 Oct 2026): variant id : units in stock, for tracked variants that do not allow overselling.
    Product page: every variant of the product. Any page: variants already in the cart (cart page).
  endcomment
  assign ed_stock = ''
  if template.name == 'product' and product
    for v in product.variants
      if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
        assign ed_stock = ed_stock | append: v.id | append: ':' | append: v.inventory_quantity | append: ','
      endif
    endfor
  endif
  if template.name == 'cart'
    for item in cart.items
      assign cv = item.variant
      if cv.inventory_management == 'shopify' and cv.inventory_policy == 'deny'
        assign ed_stock = ed_stock | append: cv.id | append: ':' | append: cv.inventory_quantity | append: ','
      endif
    endfor
  endif
-%}
