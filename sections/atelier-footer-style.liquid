<script>
/* Quantity cap (15 Oct 2026): the quantity box on the product page and in the cart cannot go above the units in stock. Shows "Only N pieces left" at 5 or fewer. The product page also counts what is already in the cart. */
(function(){
  var S = {};
  '{{ ed_stock }}'.split(',').forEach(function(p){ if(!p) return; var a = p.split(':'); S[a[0]] = Math.max(0, parseInt(a[1], 10) || 0); });
  if(!Object.keys(S).length) return;
  function noteFor(inp){
    var host = inp.closest('quantity-input') || inp.parentNode;
    var el = host.parentNode.querySelector('.ed-stocknote');
    if(!el){ el = document.createElement('p'); el.className = 'ed-stocknote'; el.setAttribute('role','status'); el.hidden = true; host.insertAdjacentElement('afterend', el); }
    return el;
  }
  function apply(inp, vid, inCart){
    var stock = S[vid]; if(stock === undefined) return;
    var eff = stock - (inCart || 0);
    var el = noteFor(inp);
    if(eff < 1){
      el.textContent = inCart ? 'All ' + stock + ' available are already in your cart.' : '';
      el.hidden = !el.textContent;
      return;
    }
    if(inp.getAttribute('max') !== String(eff)) inp.setAttribute('max', eff);
    var v = parseInt(inp.value, 10) || 0;
    if(v > eff){ inp.value = eff; v = eff; inp.dispatchEvent(new Event('change', {bubbles:true})); }
    var plus = (inp.closest('quantity-input') || inp.parentNode).querySelector('button[name="plus"]');
    if(plus){ var atMax = v >= eff; plus.classList.toggle('disabled', atMax); if(atMax) plus.setAttribute('disabled', 'disabled'); else plus.removeAttribute('disabled'); }
    var txt = '';
    if(eff <= 5) txt = 'Only ' + eff + (eff === 1 ? ' piece' : ' pieces') + ' left' + (v >= eff ? ', that is all we have.' : '');
    if(el.textContent !== txt) el.textContent = txt;
    el.hidden = !txt;
  }
  function tick(){
    if(document.hidden) return;
    document.querySelectorAll('input.quantity__input').forEach(function(inp){
      var vid = inp.getAttribute('data-quantity-variant-id'), inCart = 0;
      if(!vid){
        var f = inp.form || inp.closest('form');
        var idEl = f && f.querySelector('input[name="id"]');
        vid = idEl && idEl.value;
        inCart = parseInt(inp.getAttribute('data-cart-quantity'), 10) || 0;
      }
      if(vid) apply(inp, String(vid), inCart);
    });
  }
  document.addEventListener('DOMContentLoaded', function(){ tick(); setInterval(tick, 500); });
  document.addEventListener('input', function(e){ if(e.target && e.target.classList && e.target.classList.contains('quantity__input')) tick(); });
  document.addEventListener('change', function(){ setTimeout(tick, 50); });
})();
</script>
{%- endif -%}

