<script>
/* Gallery videos: loop, and autoplay muted when the slide is on screen (15 Oct 2026). */
(function(){
  function prep(v){ try{ v.loop=true; v.setAttribute('loop',''); v.muted=true; v.setAttribute('muted',''); v.setAttribute('playsinline',''); }catch(e){} }
  function play(v){ prep(v); var p=v.play(); if(p&&p.catch) p.catch(function(){}); }
  document.addEventListener('DOMContentLoaded', function(){
    var list = document.querySelector('.product__media-list');
    if(!list) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function scan(){
      list.querySelectorAll('video').forEach(function(v){
        if(v.dataset.edPrep) return; v.dataset.edPrep='1'; prep(v);
        if(!reduce && v.dataset.edVisible==='1') play(v); else if(reduce) v.pause();
      });
    }
    scan();
    new MutationObserver(scan).observe(list,{childList:true,subtree:true});
    if(reduce || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        var dm = en.target, v = dm.querySelector('video');
        if(en.isIntersecting){
          dm.dataset.edVisible='1';
          if(v){ play(v); }
          else if(typeof dm.loadContent==='function' && !dm.hasAttribute('loaded')){ try{ dm.loadContent(false); }catch(e){} }
        } else {
          dm.dataset.edVisible='0';
          if(v){ try{ v.pause(); }catch(e){} }
        }
      });
    },{threshold:0.6});
    list.querySelectorAll('.media-type-video deferred-media').forEach(function(dm){ io.observe(dm); });
  });
})();
</script>
<script>
/* Story video teaser (15 Oct 2026): phone and tablet only. Uses the story section's own video; a card under Add to cart opens it full screen. */
(function(){
  document.addEventListener('DOMContentLoaded', function(){
    var rv = document.querySelector('.atl-story .atl-reel video');
    if(!rv) return;
    var poster = rv.getAttribute('poster') || '';
    var s = rv.querySelector('source');
    var src = s ? s.getAttribute('src') : rv.getAttribute('src');
    if(!src) return;
    var h = document.querySelector('.atl-story h2, .atl-story h3');
    var sub = h ? h.textContent.trim() : '';
    var label = rv.getAttribute('aria-label') || 'Product video';
    var anchor = document.querySelector('.product__microcopy') || document.querySelector('product-form');
    if(!anchor) return;
    var b = document.createElement('button'); b.type = 'button'; b.className = 'ed-teaser';
    b.setAttribute('aria-label','Watch the short film');
    b.innerHTML = '<span class="ed-teaser__thumb">' + (poster ? '<img src="' + poster + '" alt="" loading="lazy">' : '') + '<span class="ed-teaser__play"><svg viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z"/></svg></span></span>'
      + '<span class="ed-teaser__txt"><span class="ed-teaser__t">Watch the short film</span>' + (sub ? '<span class="ed-teaser__s"></span>' : '') + '</span>'
      + '<svg class="ed-teaser__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
    var ss = b.querySelector('.ed-teaser__s'); if(ss) ss.textContent = sub;
    anchor.insertAdjacentElement('afterend', b);
    b.addEventListener('click', function(){ openModal(b); });
    function openModal(opener){
      var m = document.createElement('div'); m.className = 'ed-modal'; m.setAttribute('role','dialog'); m.setAttribute('aria-modal','true'); m.setAttribute('aria-label', label);
      var v = document.createElement('video'); v.controls = true; v.autoplay = true; v.setAttribute('playsinline',''); v.playsInline = true;
      if(poster) v.poster = poster; v.src = src;
      var x = document.createElement('button'); x.type = 'button'; x.className = 'ed-modal__x'; x.setAttribute('aria-label','Close video'); x.innerHTML = '&times;';
      m.appendChild(v); m.appendChild(x); document.body.appendChild(m);
      var prevOverflow = document.body.style.overflow; document.body.style.overflow = 'hidden';
      function close(){ try{ v.pause(); }catch(e){} m.remove(); document.body.style.overflow = prevOverflow; document.removeEventListener('keydown', key); if(opener) opener.focus(); }
      function key(e){ if(e.key === 'Escape') close(); }
      x.addEventListener('click', close);
      m.addEventListener('click', function(e){ if(e.target === m) close(); });
      document.addEventListener('keydown', key);
      x.focus();
      var p = v.play(); if(p && p.catch) p.catch(function(){});
    }
  });
})();
</script>
<script>
/* Desktop gallery arrows + phone photo counter (15 Oct 2026): arrows step through the visible thumbnails, wrapping at the ends, and sit on the edges of the current image. The counter pill shows n / total on phones, read from the swipe position. Photos hidden by the variant filter (class atl-vg-hide) are skipped (fixed 15 Oct 2026). */
(function(){
  document.addEventListener('DOMContentLoaded', function(){
    var viewer = document.querySelector('[id^="GalleryViewer"]');
    var thumbs = document.querySelector('[id^="GalleryThumbnails"]');
    if(!viewer || !thumbs) return;
    var prev, next, cnt, raf = 0;
    function items(){ return Array.prototype.filter.call(viewer.querySelectorAll('.product__media-item'), function(i){ return !i.hasAttribute('hidden') && !i.classList.contains('product__media-item--variant-hidden') && !i.classList.contains('atl-vg-hide'); }); }
    function count(){
      if(!cnt) return;
      var l = items(), i = 0;
      var list = viewer.querySelector('.product__media-list');
      if(window.innerWidth < 750 && list){
        var lr = list.getBoundingClientRect().left, best = 1e9;
        l.forEach(function(it,ix){ var dd = Math.abs(it.getBoundingClientRect().left - lr); if(dd < best){ best = dd; i = ix; } });
      } else {
        l.forEach(function(it,ix){ if(it.classList.contains('is-active')) i = ix; });
      }
      cnt.textContent = (i + 1) + ' / ' + l.length;
      cnt.style.display = l.length < 2 ? 'none' : '';
    }
    function place(){
      var a = viewer.querySelector('.product__media-item.is-active');
      var c = a && a.querySelector('.product-media-container');
      if(!c || !prev) return;
      var v = viewer.getBoundingClientRect(), r = c.getBoundingClientRect();
      if(!r.width) return;
      prev.style.left = Math.max(8, r.left - v.left + 12) + 'px';
      prev.style.right = 'auto';
      next.style.left = Math.max(8, r.right - v.left - 12 - next.offsetWidth) + 'px';
      next.style.right = 'auto';
      var mid = (r.top - v.top) + r.height / 2;
      prev.style.top = next.style.top = mid + 'px';
    }
    function go(dir){
      var list = items(); if(list.length < 2) return;
      var cur = 0; list.forEach(function(it,ix){ if(it.classList.contains('is-active')) cur = ix; });
      var nxt = list[(cur + dir + list.length) % list.length];
      var li = Array.prototype.filter.call(thumbs.querySelectorAll('li[data-target]'), function(l){ return l.getAttribute('data-target') === nxt.getAttribute('data-media-id'); })[0];
      var b = li && li.querySelector('button'); if(b) b.click();
      setTimeout(place, 80); setTimeout(place, 400);
    }
    var svg = function(d){ return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="' + d + '"/></svg>'; };
    function mk(cls,label,d,dir){ var b = document.createElement('button'); b.type='button'; b.className='ed-garrow '+cls; b.setAttribute('aria-label',label); b.innerHTML = svg(d); b.addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation(); go(dir); }); return b; }
    if(getComputedStyle(viewer).position === 'static') viewer.style.position='relative';
    prev = mk('ed-garrow--prev','Previous image','M15 18l-6-6 6-6',-1);
    next = mk('ed-garrow--next','Next image','M9 18l6-6-6-6',1);
    cnt = document.createElement('div'); cnt.className = 'ed-gcount'; cnt.setAttribute('aria-hidden','true');
    viewer.appendChild(prev); viewer.appendChild(next); viewer.appendChild(cnt);
    place(); count(); setTimeout(place, 300); setTimeout(place, 1200); setTimeout(count, 600);
    window.addEventListener('resize', function(){ place(); count(); }); window.addEventListener('load', function(){ place(); count(); });
    thumbs.addEventListener('click', function(){ setTimeout(place, 80); setTimeout(place, 400); setTimeout(count, 120); setTimeout(count, 600); });
    var sl = viewer.querySelector('.product__media-list');
    if(sl) sl.addEventListener('scroll', function(){ if(raf) return; raf = requestAnimationFrame(function(){ raf = 0; count(); }); }, {passive:true});
    new MutationObserver(function(){ place(); count(); }).observe(viewer, {attributes:true, subtree:true, attributeFilter:['class','hidden']});
  });
})();
</script>
