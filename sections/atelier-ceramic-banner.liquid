{%- comment -%} Ceramic family banner: text on the left, edge-to-edge photo on the right. On phones the photo sits on top. Styled like the Experience Store / Gifting band (19 Oct 2026): regular headline with a coral italic accent, coral rule, theme colour scheme. The whole banner is clickable (20 Oct 2026): the button link is stretched over the photo and text through a ::before, so there is one link, one tab stop and one destination. {%- endcomment -%}
{%- assign cb_title = section.settings.title | replace: 'Hand-carved', '<em style="white-space:nowrap">Hand-carved</em>' -%}
<style>
#cb-{{ section.id }}{overflow:hidden;position:relative}
#cb-{{ section.id }} .cb-in{display:grid;grid-template-columns:1fr}
#cb-{{ section.id }} .cb-media{margin:0;order:-1;aspect-ratio:5/4;min-width:0;background:#e6dccf;overflow:hidden}
#cb-{{ section.id }} .cb-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}
#cb-{{ section.id }}:hover .cb-media img{transform:scale(1.03)}
#cb-{{ section.id }} .cb-txt{padding:3rem 2.2rem 3.4rem;min-width:0;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}
#cb-{{ section.id }} .cb-eye{font-size:1.2rem;letter-spacing:.22em;text-transform:uppercase;color:var(--a-ochre,#cf4a25);margin:0 0 1.2rem}
#cb-{{ section.id }} .cb-title{font-family:var(--font-heading-family);font-weight:400;font-size:clamp(2.6rem,7vw,4.2rem);line-height:1.12;margin:0;text-wrap:balance}
#cb-{{ section.id }} .cb-title em{color:var(--a-ochre,#cf4a25);font-style:italic}
#cb-{{ section.id }} .cb-rule{display:block;width:4rem;height:2px;background:var(--a-ochre,#cf4a25);margin:1.8rem auto}
#cb-{{ section.id }} .cb-text{color:var(--a-muted,rgba(var(--color-foreground),.7));font-size:1.5rem;line-height:1.7;margin:0 auto 2.2rem;max-width:46ch}
#cb-{{ section.id }} .cb-cta{display:inline-flex;align-items:center;justify-content:center;min-height:4.4rem;border:1px solid var(--a-ink,#14213d);padding:1.2rem 2.6rem;font-size:1.2rem;letter-spacing:.18em;text-transform:uppercase;text-decoration:none;color:inherit;transition:background .2s,color .2s}
#cb-{{ section.id }} .cb-cta:hover,#cb-{{ section.id }} .cb-cta:focus-visible{background:var(--a-ink,#14213d);color:#fff}
#cb-{{ section.id }} .cb-cta::before{content:"";position:absolute;inset:0;z-index:1;cursor:pointer}
#cb-{{ section.id }} .cb-cta:focus-visible{outline:2px solid #cf4a25;outline-offset:-4px}
@media(min-width:750px){
#cb-{{ section.id }} .cb-in{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);min-height:48rem}
#cb-{{ section.id }} .cb-media{order:0;aspect-ratio:auto}
#cb-{{ section.id }} .cb-txt{padding:5rem clamp(3rem,5vw,8rem);align-items:flex-start;text-align:left}
#cb-{{ section.id }} .cb-title{font-size:clamp(3.2rem,3.6vw,4.2rem)}
#cb-{{ section.id }} .cb-rule{margin:2rem 0}
#cb-{{ section.id }} .cb-text{margin-inline:0}
}
</style>
<section id="cb-{{ section.id }}" class="cb color-{{ section.settings.color_scheme }} gradient" aria-label="{{ section.settings.title | strip_html | escape }}">
  <div class="cb-in">
    <div class="cb-txt">
      {%- if section.settings.eyebrow != blank -%}<p class="cb-eye">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cb-title">{{ cb_title }}</h2>
      <span class="cb-rule"></span>
      {%- if section.settings.text != blank -%}<p class="cb-text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}<a class="cb-cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
    <figure class="cb-media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 52vw, 100vw', alt: section.settings.image_alt }}
      {%- endif -%}
    </figure>
  </div>
</section>
{% schema %}
{
  "name": "Ceramic banner",
  "settings": [
    {"type":"image_picker","id":"image","label":"Photo (about 5:4, edge to edge)"},
    {"type":"text","id":"image_alt","label":"Photo description","default":"Four Imber ceramic vases in Ocean Blue and Earthy Brown"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"New · Ceramic"},
    {"type":"inline_richtext","id":"title","label":"Headline","default":"Imber. Hand-carved in Khurja.","info":"The words Hand-carved turn coral italic automatically."},
    {"type":"textarea","id":"text","label":"Text","default":"Four vases, each carved by hand. Made to hold dried stems or stand on their own."},
    {"type":"text","id":"cta_label","label":"Button label","default":"Shop the Imber family","info":"The whole banner links to the button link below."},
    {"type":"url","id":"link","label":"Button link"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}
  ],
  "presets": [{"name":"Ceramic banner"}]
}
{% endschema %}
