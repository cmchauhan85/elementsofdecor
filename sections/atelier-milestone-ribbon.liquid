{%- comment -%}
  Bundle offer bar for the cart (slim progress bar, top of the cart). LOCKED layout.
  Real automatic discounts: buy 2 pieces get 5% off, buy 3 or more get 10% off.
  Only pieces priced Rs. 500 or more count (the 'bundle-offer-eligible' smart collection mirrors this rule).
  This section also owns the refresh script that re-renders every [data-bs-wrap] block on cart changes,
  and the one-tap add handler used by the 'Add more pieces' section (soft refresh, no page reload).
{%- endcomment -%}
{%- liquid
  assign n = 0
  for item in cart.items
    if item.original_price >= 50000
      assign n = n | plus: item.quantity
    endif
  endfor
  assign pct = 0
  if n == 1
    assign pct = 34
  elsif n == 2
    assign pct = 67
  elsif n >= 3
    assign pct = 100
  endif
-%}
<div class="atl-bs-wrap" data-bs-wrap data-bs-section="{{ section.id }}">
{%- if cart.item_count > 0 -%}
<div class="atl-bs atl-bs--slim">
  <div class="page-width">
    <p class="atl-bs__line">
      {%- if n >= 3 -%}
        <span class="atl-bs__ok">&#10003;</span> You are getting <strong>10% off</strong> your whole order
      {%- elsif n == 2 -%}
        You are getting <strong>5% off</strong>. Add <strong>1 more piece</strong> to get <strong>10% off</strong>
      {%- elsif n == 1 -%}
        Add <strong>1 more piece</strong> to get <strong>5% off</strong> your order
      {%- else -%}
        Buy <strong>2 pieces, get 5% off</strong>. Buy <strong>3, get 10% off</strong>
      {%- endif -%}
    </p>
    <div class="atl-bs__track" role="progressbar" aria-valuemin="0" aria-valuemax="3" aria-valuenow="{{ n }}"><span style="width:{{ pct }}%"></span><i class="atl-bs__tick atl-bs__tick--a{% if n >= 2 %} is-on{% endif %}"></i><i class="atl-bs__tick atl-bs__tick--b{% if n >= 3 %} is-on{% endif %}"></i></div>
    <div class="atl-bs__marks"><span>Your bag</span><span class="{% if n >= 2 %}is-on{% endif %}">2 pieces: 5% off</span><span class="{% if n >= 3 %}is-on{% endif %}">3+ pieces: 10% off</span></div>
  </div>
</div>
{%- endif -%}
</div>
<style>
.atl-bs{background:#f5f2eb;border-top:1px solid #d9d0c3;border-bottom:1px solid #d9d0c3;color:#14213d}
.atl-bs--slim{padding:1.2rem 0 1.3rem}
.atl-bs__ok{color:#2f6b4f;font-weight:700}
.atl-bs__line{margin:0 0 1rem;font-size:1.45rem;line-height:1.4;text-align:center}
.atl-bs__line strong{color:#a8371a}
.atl-bs__track{position:relative;height:.6rem;border-radius:1rem;background:#e6dfd2;max-width:42rem;margin:0 auto}
.atl-bs__track>span{display:block;height:100%;border-radius:1rem;background:#cf4a25;transition:width .3s}
.atl-bs__tick{position:absolute;top:-.3rem;width:1.2rem;height:1.2rem;border-radius:50%;background:#fff;border:2px solid #d9d0c3;transform:translateX(-50%)}
.atl-bs__tick--a{left:67%}.atl-bs__tick--b{left:100%}
.atl-bs__tick.is-on{background:#cf4a25;border-color:#cf4a25}
.atl-bs__marks{display:grid;grid-template-columns:1fr 1fr 1fr;max-width:42rem;margin:.9rem auto 0;font-size:1.15rem;color:rgba(20,33,61,.62)}
.atl-bs__marks span:nth-child(1){text-align:left}
.atl-bs__marks span:nth-child(2){text-align:center}
.atl-bs__marks span:nth-child(3){text-align:right}
.atl-bs__marks .is-on{color:#2f6b4f;font-weight:700}
</style>
<script>
(function(){
  if(window.__atlBs)return;window.__atlBs=1;
  var busy=false,again=false;
  function refresh(){
    if(busy){again=true;return Promise.resolve()}busy=true;
    var cur=[].slice.call(document.querySelectorAll('[data-bs-wrap]'));
    return Promise.all(cur.map(function(w){var id=w.getAttribute('data-bs-section');
      return fetch(window.location.pathname+'?section_id='+id+'&t='+Date.now()).then(function(r){return r.text()}).then(function(h){
        var d=new DOMParser().parseFromString(h,'text/html'),nw=d.querySelector('[data-bs-wrap]');if(nw)w.innerHTML=nw.innerHTML})
    })).catch(function(){}).then(function(){busy=false;if(again){again=false;refresh()}})
  }
  /* soft refresh after a one-tap add: swap items, summary, bar and cart count without reloading */
  function soft(){
    return fetch(window.location.pathname+'?t='+Date.now()).then(function(r){return r.text()}).then(function(h){
      var d=new DOMParser().parseFromString(h,'text/html');
      [['#main-cart-items .js-contents'],['#main-cart-footer .js-contents'],['#cart-icon-bubble']].forEach(function(p){
        var a=document.querySelector(p[0]),b=d.querySelector(p[0]);if(a&&b)a.innerHTML=b.innerHTML});
    }).then(refresh)
  }
  try{if(typeof subscribe==='function'&&typeof PUB_SUB_EVENTS!=='undefined'){subscribe(PUB_SUB_EVENTS.cartUpdate,function(){setTimeout(refresh,250)})}}catch(e){}
  var bubble=document.querySelector('#cart-icon-bubble'),t=null;
  if(bubble)new MutationObserver(function(){clearTimeout(t);t=setTimeout(refresh,400)}).observe(bubble,{childList:true,subtree:true,characterData:true});
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-am-add]');if(!b||b.disabled)return;
    var orig=b.textContent;b.disabled=true;b.textContent='Adding…';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:Number(b.getAttribute('data-am-add')),quantity:1})})
      .then(function(r){return r.json()}).then(function(j){if(j.status)throw 0;return soft()})
      .then(function(){b.textContent='Added ✓';setTimeout(function(){b.textContent=orig;b.disabled=false},1600)})
      .catch(function(){b.textContent='Try again';b.disabled=false})
  });
})();
</script>

{% schema %}
{
  "name": "Bundle offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (unused)", "default": "Bundle and save" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme (unused)", "default": "scheme-2" }
  ]
}
{% endschema %}
