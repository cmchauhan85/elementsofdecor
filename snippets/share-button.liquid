{%- comment -%} PDP tweaks (CRO audit): (1) Share icon on main photo, top-right, link carries utm_source=share&utm_medium=pdp; replaces old bottom 'Share' block (item 3). (2) Quantity stepper beside Add to bag, Buy Now full-width below (item 4). (3) Need-help-choosing: two tiles side by side, bulk/GST note in a tap-to-open line (item 5, Layout 3). (4) Craft pill on the main photo from atelier.craft metafield (item 6, Layout 1); no pill if empty. (5) Payment-method chips under the buy buttons (item 7, Layout 1): UPI, Cards, Net banking, Cash on delivery - keep in sync with what checkout really accepts. (6) Delivery card as in the audit suggestion (item 8): dispatch line + delivery range (3-7 business days, remote areas longer) + free delivery chip; PIN box hidden (still in the theme, not deleted). {%- endcomment -%}
<div id="eod-share-anchor" hidden></div>
<div id="eod-pill-data" hidden data-craft="{{ product.metafields.atelier.craft.value | escape }}"></div>
<style>
.eod-sh{position:absolute;z-index:5;top:1.2rem;right:1.2rem;width:4.4rem;height:4.4rem;border-radius:50%;border:1px solid #d9d0c3;background:rgba(255,255,255,.95);color:#14213d;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;box-shadow:0 1px 4px rgba(20,33,61,.15)}
.eod-sh svg{width:2rem;height:2rem}
.eod-toast{position:fixed;left:50%;bottom:3rem;transform:translateX(-50%);background:#14213d;color:#fff;padding:1rem 1.8rem;border-radius:.6rem;font-size:1.4rem;z-index:10001;opacity:0;transition:opacity .2s;pointer-events:none}
.eod-toast.on{opacity:1}
share-button,.share-button{display:none!important}
html.eod-qrow .product-form__quantity{display:none!important}
html.eod-qrow .product__buy-buttons{display:grid!important;grid-template-columns:14rem 1fr;gap:1rem;align-items:stretch}
html.eod-qrow .product__buy-buttons>quantity-input{grid-column:1;grid-row:1;margin:0;width:100%;max-width:none;min-width:0;min-height:5.4rem;height:auto;display:flex}
html.eod-qrow .product__buy-buttons>quantity-input .quantity__input{flex:1;min-width:0}
html.eod-qrow .product__buy-buttons>.btn-secondary{grid-column:2;grid-row:1;margin:0;width:100%}
html.eod-qrow .product__buy-buttons>.btn-primary{grid-column:1/-1;grid-row:2;margin:0;width:100%}
html.eod-help3 .eod-help{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:2.4rem 0}
html.eod-help3 .eod-help>.atl-helpbox,html.eod-help3 .eod-help>.eod-bulk{grid-column:1/-1;margin:0}
html.eod-help3 .eod-help>.atl-pdp-box{display:none}
html.eod-help3 .product .eod-help a.product__whatsapp-button{display:flex!important;align-items:center;justify-content:flex-start!important;gap:.8rem;width:auto!important;margin:0!important;padding:1.4rem 1.2rem!important;background:#f5f2eb!important;border:1px solid #d9d0c3!important;border-radius:.6rem!important;text-decoration:none!important;font-size:1.1rem!important;letter-spacing:.12em;text-transform:uppercase;font-weight:600;color:#14213d!important;line-height:1.4}
.eod-bulk{display:none;border:1px solid #d9d0c3;border-radius:.6rem;background:#f5f2eb;padding:0 1.4rem;font-size:1.3rem;line-height:1.6}
html.eod-help3 .eod-bulk{display:block}
.eod-bulk summary{cursor:pointer;padding:1.3rem 0;font-weight:600;font-size:1.2rem;letter-spacing:.06em;text-transform:uppercase}
.eod-bulk div{padding:0 0 1.4rem}
.eod-bulk a{text-decoration:underline;text-underline-offset:3px}
.eod-pill{position:absolute;z-index:4;left:1.2rem;bottom:1.2rem;max-width:calc(100% - 2.4rem);padding:.6rem 1.2rem;border-radius:2rem;background:rgba(255,255,255,.92);border:1px solid #d9d0c3;color:#14213d;font-size:1.05rem;line-height:1.3;font-weight:600;letter-spacing:.1em;text-transform:uppercase;pointer-events:none}
.eod-pay{margin:1.4rem 0 0;color:#14213d}
.eod-pay-chips{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center}
.eod-pay-chips span.l{font-size:1.1rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(20,33,61,.7);margin-right:.2rem}
.eod-pay-chips span.c{padding:.55rem 1.2rem;border:1px solid #d9d0c3;border-radius:2rem;background:#f5f2eb;font-size:1.2rem;line-height:1.2;font-weight:600}
.eod-dlv{background:#fbf9f5;border:1px solid #e4dccf;border-radius:1.6rem;padding:1.8rem 2rem;margin:1.8rem 0;color:#14213d;box-shadow:0 1px 3px rgba(20,33,61,.05)}
.eod-dlv .atelier-pdp-dispatch,.eod-dlv .atelier-delivery-estimate{display:none}
.eod-dlv .hd{display:flex;align-items:center;gap:1rem;font-size:1.4rem;font-weight:600;line-height:1.4}
.eod-dlv .hd i{flex:none;width:1rem;height:1rem;border-radius:50%;background:#2e8b57}
.eod-dlv .pk{margin:.3rem 0 0 2rem;font-size:1.25rem;color:rgba(20,33,61,.7)}
.eod-dlv .rule{height:1px;background:#e4dccf;margin:1.4rem 0}
.eod-dlv .tt{display:flex;align-items:center;gap:1rem;font-size:1.2rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700}
.eod-dlv .tt svg,.eod-dlv .bx svg{flex:none;width:2rem;height:2rem;color:#8a6a2b}
.eod-dlv .st{margin:.5rem 0 0 3rem;font-size:1.25rem;line-height:1.5;color:rgba(20,33,61,.65)}
.eod-dlv .bx{display:flex;flex-direction:column;align-items:flex-start;gap:1rem;margin-top:1.4rem;padding:1.3rem 1.4rem;background:#fff;border:1px solid #e4dccf;border-radius:1.2rem;font-size:1.3rem;line-height:1.4}
.eod-dlv .bx .tx{display:flex;align-items:center;gap:1rem}
.eod-dlv .bx b{color:#cf4a25;font-weight:600}
.eod-dlv .bx .chip{margin-left:3rem;padding:.6rem 1.3rem;border:1px solid #e4dccf;border-radius:2rem;background:#f5f0e6;color:#8a6a2b;font-size:1.05rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}
</style>
<script>
(function(){
 var ICON='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.3 10.8l7.4-4.4M8.3 13.2l7.4 4.4"/></svg>';
 var PIN='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 005 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>';
 var TRUCK='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4.5l3.5 3.5V16h-8"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>';
 var toast;
 function url(){return location.origin+location.pathname+'?utm_source=share&utm_medium=pdp'}
 function say(m){if(!toast){toast=document.createElement('div');toast.className='eod-toast';document.body.appendChild(toast)}toast.textContent=m;toast.classList.add('on');setTimeout(function(){toast.classList.remove('on')},2200)}
 function share(){
  var d={title:document.title,text:document.title,url:url()};
  if(navigator.share){navigator.share(d).catch(function(){})}
  else if(navigator.clipboard){navigator.clipboard.writeText(d.url).then(function(){say('Link copied')},function(){say(d.url)})}
  else{say(d.url)}
 }
 function initShare(){
  if(document.querySelector('.eod-sh'))return;
  var host=document.querySelector('media-gallery .product__media-wrapper')||document.querySelector('.product__media-wrapper')||document.querySelector('media-gallery');
  if(!host)return;
  if(getComputedStyle(host).position==='static')host.style.position='relative';
  var b=document.createElement('button');b.type='button';b.className='eod-sh';b.setAttribute('aria-label','Share this product');b.innerHTML=ICON;b.addEventListener('click',share);
  host.appendChild(b);
 }
 function qrow(){
  var bb=document.querySelector('.product__buy-buttons');
  if(!bb)return;
  if(bb.querySelector(':scope>quantity-input')){document.documentElement.classList.add('eod-qrow');return}
  var q=document.querySelector('.product-form__quantity quantity-input')||document.querySelector('quantity-input');
  if(!q)return;
  bb.insertBefore(q,bb.firstChild);
  document.documentElement.classList.add('eod-qrow');
 }
 function help(){
  if(document.querySelector('.eod-help'))return;
  var hb=document.querySelector('.atl-helpbox'),bulk=document.querySelector('.atl-pdp-box');
  if(!hb||!bulk||hb.parentNode!==bulk.parentNode)return;
  var c=document.createElement('div');c.className='eod-help';
  hb.parentNode.insertBefore(c,hb);
  var n=hb;
  while(n){var nx=n.nextSibling;c.appendChild(n);if(n===bulk)break;n=nx}
  var strong=bulk.querySelector('strong');
  var d=document.createElement('details');d.className='eod-bulk';
  var inner=bulk.innerHTML.replace(/<strong>[\s\S]*?<\/strong>/,'');
  d.innerHTML='<summary>'+(strong?strong.textContent:'Bulk pricing or a GST invoice?')+'</summary><div>'+inner+'</div>';
  c.appendChild(d);
  document.documentElement.classList.add('eod-help3');
 }
 function pill(){
  if(document.querySelector('.eod-pill'))return;
  var e=document.getElementById('eod-pill-data');if(!e)return;
  var s=(e.dataset.craft||'').trim();if(!s)return;
  if(s.length>32)s=s.split(',')[0].trim();
  var host=document.querySelector('slider-component[id^="GalleryViewer"]')||document.querySelector('media-gallery');
  if(!host)return;
  if(getComputedStyle(host).position==='static')host.style.position='relative';
  var p=document.createElement('div');p.className='eod-pill';p.textContent=s;host.appendChild(p);
 }
 function pay(){
  if(document.querySelector('.eod-pay'))return;
  var a=document.querySelector('product-form');if(!a)return;
  var d=document.createElement('div');d.className='eod-pay';
  d.innerHTML='<div class="eod-pay-chips"><span class="l">Pay with</span><span class="c">UPI</span><span class="c">Cards</span><span class="c">Net banking</span><span class="c">Cash on delivery</span></div>';
  a.parentNode.insertBefore(d,a.nextSibling);
 }
 function dlv(){
  if(document.querySelector('.eod-dlv'))return;
  var d=document.querySelector('.atelier-pdp-dispatch'),e=document.querySelector('.atelier-delivery-estimate');
  if(!d||!e)return;
  var w=document.createElement('div');w.className='eod-dlv';
  d.parentNode.insertBefore(w,d);
  var line=(d.querySelector('.atelier-pdp-dispatch__line:not(.atelier-pdp-dispatch__packing)')||d).textContent.replace('◷','').replace(/\s+/g,' ').trim();
  var pack=((d.querySelector('.atelier-pdp-dispatch__packing')||{}).textContent||'').trim();
  var h=document.createElement('div');h.className='hd';h.innerHTML='<i></i><span></span>';h.querySelector('span').textContent=line;
  w.appendChild(h);
  if(pack){var pk=document.createElement('div');pk.className='pk';pk.textContent=pack;w.appendChild(pk)}
  var r=document.createElement('div');r.className='rule';w.appendChild(r);
  var t=document.createElement('div');t.className='tt';t.innerHTML=PIN+'<span>Estimated delivery</span>';w.appendChild(t);
  var s=document.createElement('div');s.className='st';s.textContent='After dispatch. Remote areas may take longer.';w.appendChild(s);
  var b=document.createElement('div');b.className='bx';b.innerHTML='<span class="tx">'+TRUCK+'<span><b>Est. delivery:</b> 3–7 business days</span></span><span class="chip">Free delivery</span>';w.appendChild(b);
  w.appendChild(d);w.appendChild(e);
 }
 var tm;
 function all(){initShare();qrow();help();pill();pay();dlv()}
 function init(){
  all();
  var pi=document.querySelector('product-info')||document.body;
  new MutationObserver(function(){clearTimeout(tm);tm=setTimeout(all,60)}).observe(pi,{childList:true,subtree:true});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
