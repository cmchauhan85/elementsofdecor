{%- when 'acc' -%}
{%- assign want = items | split: ',' -%}
{%- for it in want -%}
{%- assign show = false -%}
{%- case it -%}
{%- when 'details' -%}{%- assign head = 'Details' -%}{%- assign show = true -%}
{%- when 'care' -%}{%- assign head = 'Care' -%}{%- if mf.care != blank -%}{%- assign show = true -%}{%- endif -%}
{%- when 'inbox' -%}{%- assign head = 'In the box' -%}{%- if mf.in_the_box != blank -%}{%- assign show = true -%}{%- endif -%}
{%- when 'ship' -%}{%- assign head = 'Shipping & Returns' -%}{%- assign show = true -%}
{%- endcase -%}
{%- if show -%}
<div class="product__accordion accordion quick-add-hidden"><details><summary><div class="summary__title"><h2 class="h4 accordion__title">{{ head }}</h2></div>{{- 'icon-caret.svg' | inline_asset_content -}}</summary>
<div class="accordion__content rte">
{%- case it -%}
{%- when 'details' -%}<dl class="atl-dl">
{%- if mf.material_text != blank -%}<dt>Material</dt><dd>{{ mf.material_text }}</dd>{%- endif -%}
{%- if mf.finish_text != blank -%}<dt>Finish</dt><dd>{{ mf.finish_text }}</dd>{%- endif -%}
{%- if mf.craft != blank -%}<dt>Craft</dt><dd>{{ mf.craft }}</dd>{%- endif -%}
{%- if mf.origin != blank -%}<dt>Made in</dt><dd>{{ mf.origin }}</dd>{%- endif -%}
{%- if mf.size_text != blank -%}<dt>Size</dt><dd>{{ mf.size_text | replace: ' || ', '<br>' }}</dd>{%- endif -%}
</dl>
{%- when 'care' -%}<p>{{ mf.care | newline_to_br }}</p>
{%- when 'inbox' -%}<p>{{ mf.in_the_box }}</p>
{%- when 'ship' -%}{%- capture nrv -%}{%- render 'atelier-returns', part: 'flag', product: product -%}{%- endcapture -%}{%- assign nrv = nrv | strip -%}{%- render 'atelier-returns', part: 'body', nr: nrv, product: product -%}
{%- endcase -%}
</div></details></div>
{%- endif -%}
{%- endfor -%}
{%- endcase -%}
