<style>
.atl-dl{display:grid;grid-template-columns:9rem 1fr;gap:.6rem 1.2rem;margin:0;font-size:1.4rem}
.atl-dl dt{color:rgba(var(--color-foreground),.6)}
.atl-dl dd{margin:0}
@media(max-width:749px){.atl-dl{grid-template-columns:7rem 1fr}}
</style>
{%- case part -%}
{%- when 'style' -%}<style>
#MainContent{--font-heading-family:{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }};--font-heading-style:{{ settings.type_header_font.style }};--font-heading-weight:{{ settings.type_header_font.weight }};--font-body-family:{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }};--font-body-style:{{ settings.type_body_font.style }};--font-body-weight:{{ settings.type_body_font.weight }};--font-body-weight-bold:{{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};font-family:var(--font-body-family)}#MainContent h1,#MainContent h2,#MainContent h3,#MainContent h4,#MainContent h5,#MainContent .h0,#MainContent .h1,#MainContent .h2,#MainContent .h3,#MainContent .h4,#MainContent .h5{letter-spacing:calc(var(--font-heading-scale)*.06rem)}
.atl-dims{margin:0 0 2.4rem;padding:0;border:0}.atl-dims[data-size]:not(.is-on){display:none}.atl-dims svg{display:block;width:100%;max-width:38rem;height:auto;margin:.4rem 0 0;color:rgb(var(--color-foreground))}.atl-dims g.sh *{vector-effect:non-scaling-stroke}.atl-dims text{font-family:var(--font-body-family);font-size:11px;fill:currentColor;letter-spacing:.04em}.atl-dims__cap{display:flex;gap:2.4rem;margin:.6rem 0 0;font-size:1.2rem;color:rgba(var(--color-foreground),.7)}.atl-dims__cap b{font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:1rem;margin-right:.6rem;color:rgba(var(--color-foreground),.6)}
.atl-eye{font-family:var(--font-body-family);font-size:1.2rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--a-ochre);margin:0 0 1.4rem;line-height:1.2}
.atl-h1{font-family:var(--font-heading-family);font-weight:400;font-size:clamp(3.4rem,4.6vw,5.4rem);line-height:1.04;letter-spacing:var(--a-display-tracking);margin:0;text-wrap:balance}
.atl-h1 em{font-style:italic;color:var(--a-ochre)}.atl-h1__sub{display:block;margin-top:.8rem;font-size:.42em;font-style:italic;opacity:.65;letter-spacing:0}
.atl-rule{display:block;width:4rem;height:2px;background:var(--a-ochre);margin:2rem 0 1.8rem}
.atl-tag2{font-family:var(--font-heading-family);font-style:italic;font-size:2.1rem;line-height:1.35;color:rgba(var(--color-foreground),.7);margin:0 0 2rem;max-width:42ch}
.product .price{font-family:var(--font-heading-family)}
.product .price .price-item{font-size:3.2rem;font-weight:400;letter-spacing:var(--a-display-tracking)}
.atl-facts2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem 3rem;margin:2rem 0 2.4rem;padding-top:2rem;border-top:1px solid rgba(var(--color-foreground),.2)}
.atl-facts2 dt{font-size:1rem;letter-spacing:.32em;text-transform:uppercase;color:rgba(var(--color-foreground),.6);margin:0 0 .6rem}
.atl-facts2 dd{margin:0;font-family:var(--font-heading-family);font-size:1.8rem;line-height:1.25}
.atl-trust{display:flex;margin:2.4rem 0 0;background:rgba(var(--color-foreground),.05);padding:1.4rem 0}
.atl-trust div{flex:1 1 0;display:flex;align-items:center;justify-content:center;gap:.8rem;padding:0 1rem;border-left:1px solid rgba(var(--color-foreground),.2);min-width:0}
.atl-trust div:first-child{border-left:0}
.atl-trust svg{width:2rem;height:2rem;flex-shrink:0;color:var(--a-ochre)}
.atl-trust span{font-size:1.05rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;line-height:1.3}
.product .product-form__buttons .button--secondary,.product .product__whatsapp-button{border-radius:0;font-size:1.2rem;letter-spacing:.18em;text-transform:uppercase}
.product .accordion__title{font-size:1.2rem;letter-spacing:.14em}
.atl-helpbox{margin:3.2rem 0 0;padding-top:2.4rem;border-top:1px solid rgba(var(--color-foreground),.2)}
.atl-helpbox p{margin:0}
.atl-helpbox .atl-eye{margin-bottom:.6rem}
.atl-helpbox .atl-hsub{font-family:var(--font-heading-family);font-size:2.4rem;line-height:1.15}
.atl-helpbox .atl-hsub em{font-style:italic;color:var(--a-ochre)}
@media(max-width:749px){.atl-facts2{gap:1.2rem}.atl-facts2 dd{font-size:1.5rem}.atl-tag2{font-size:1.8rem}.atl-trust span{font-size:.95rem;letter-spacing:.04em}.atl-trust div{flex-direction:column;gap:.4rem;text-align:center;padding:0 .4rem}.product .price .price-item{font-size:2.6rem}}
