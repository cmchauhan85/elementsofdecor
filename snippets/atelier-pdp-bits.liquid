t-"],html[data-pdp-m="3"] [class*="color-scheme-"]:has([id^="MainProduct-"]){background:#14213d!important;color:#fff;--color-foreground:255,255,255;--color-background:20,33,61}html[data-pdp-m="3"] .product__media-wrapper .media,html[data-pdp-m="3"] .product__media-wrapper img{border-radius:var(--a-radius-image,.6rem)}html[data-pdp-m="3"] .product .product-form__input--pill input[type=radio]+label{color:#fff!important;border-color:rgba(255,255,255,.4)!important}html[data-pdp-m="3"] .product .product-form__input--pill input[type=radio]:checked+label{background:#fff!important;color:#14213d!important}html[data-pdp-m="3"] .product .accordion{border-color:rgba(255,255,255,.2)}html[data-pdp-m="3"] .product .caption-with-letter-spacing,html[data-pdp-m="3"] .product .form__label{color:rgba(255,255,255,.7)!important}html[data-pdp-m="3"] .atl-eye{color:var(--a-ochre-light)}html[data-pdp-m="3"] .atl-h1 em,html[data-pdp-m="3"] .atl-helpbox .atl-hsub em{color:var(--a-ochre-light)}}</style>
{%- when 'eyebrow' -%}{%- assign city = mf.origin | split: ',' | first -%}<p class="atl-eye">{{ product.type }}{%- if city != blank %} · {{ city }}{%- endif -%}</p>
{%- when 'title' -%}{%- assign tparts = product.title | split: ',' -%}{%- assign tmain = tparts[0] -%}{%- assign tw = tmain | split: ' ' -%}<h1 class="atl-h1">{%- for w in tw -%}{%- if forloop.last and tw.size > 1 -%}<em>{{ w }}</em>{%- else -%}{{ w }} {%- endif -%}{%- endfor -%}{%- if tparts.size > 1 -%}<span class="atl-h1__sub">{{ tparts[1] | strip }}</span>{%- endif -%}</h1>
{%- when 'rule' -%}<span class="atl-rule"></span>
{%- when 'tagline2' -%}{%- if mf.tagline != blank -%}<p class="atl-tag2">{{ mf.tagline }}</p>{%- endif -%}
{%- when 'facts2' -%}<dl class="atl-facts2">{%- if mf.material_text != blank -%}<div><dt>Material</dt><dd>{{ mf.material_text }}</dd></div>{%- endif -%}{%- if mf.finish_text != blank -%}<div><dt>Surface</dt><dd>{{ mf.finish_text }}</dd></div>{%- endif -%}{%- if mf.craft != blank -%}<div><dt>Craft</dt><dd>{{ mf.craft | split: ',' | first }}</dd></div>{%- endif -%}{%- assign ocity = mf.origin | split: ',' | first -%}{%- if ocity != blank -%}<div><dt>Made in</dt><dd>{{ ocity }}</dd></div>{%- endif -%}</dl>
{%- assign sel = product.selected_or_first_available_variant.option1 | downcase -%}
{%- assign ents = mf.size_text | split: '||' -%}
{%- for ent in ents -%}
{%- assign ent = ent | strip -%}
{%- assign lab = '' -%}{%- assign rest = ent -%}
{%- if ent contains ': ' -%}{%- assign lab = ent | split: ': ' | first | strip -%}{%- assign rest = ent | remove_first: lab | remove_first: ': ' -%}{%- endif -%}
{%- assign labd = lab | downcase -%}
{%- assign sz = rest | replace: '×', 'x' | split: ' · ' -%}
{%- assign dstr = sz[0] | remove: ' cm' | remove: 'cm' -%}
{%- assign dp = dstr | split: ' x ' -%}
{%- if dp.size >= 3 -%}
{%- assign dl = dp[0] | strip | plus: 0.0 -%}{%- assign db = dp[1] | strip -%}{%- assign dh = dp[2] | strip | plus: 0.0 -%}
{%- if dl > 0 and dh > 0 -%}
{%- assign key = product.title | append: ' ' | append: product.type | downcase -%}
{%- assign shape = 'block' -%}
{%- if key contains 'tree' -%}{%- assign shape = 'tree' -%}{%- elsif key contains 'ekam' or key contains 'metal urli' -%}{%- assign shape = 'ekam' -%}{%- elsif key contains 'flame' -%}{%- assign shape = 'flame' -%}{%- elsif key contains 'rose' -%}{%- assign shape = 'rose' -%}{%- elsif key contains '3 tier' -%}{%- assign shape = 'tier3' -%}{%- elsif key contains 'flower candle' -%}{%- assign shape = 'flowerstand' -%}{%- elsif key contains 'urli' or key contains 'bowl' -%}{%- assign shape = 'bowl' -%}{%- elsif key contains 'round bud' -%}{%- assign shape = 'bud' -%}{%- elsif key contains 'long-neck' -%}{%- assign shape = 'longneck' -%}{%- elsif key contains 'imber tall' -%}{%- assign shape = 'ovoid' -%}{%- elsif key contains 'aurum' -%}{%- assign shape = 'bottle' -%}{%- elsif key contains 'elio' -%}{%- assign shape = 'cone' -%}{%- elsif key contains 'globe' -%}{%- assign shape = 'globe' -%}{%- elsif key contains 'vase' -%}{%- assign shape = 'vase' -%}{%- elsif key contains 'candle' or key contains 'holder' or key contains 'stand' -%}{%- assign shape = 'stand' -%}{%- endif -%}
{%- assign r = dl | divided_by: dh -%}
{%- if r >= 1.3 -%}{%- assign bw = 150.0 -%}{%- assign bh = 150.0 | divided_by: r -%}{%- else -%}{%- assign bh = 115.0 -%}{%- assign bw = r | times: 115.0 -%}{%- endif -%}
{%- assign bw = bw | at_least: 16 -%}{%- assign bh = bh | at_least: 16 -%}
{%- assign bx = 300.0 | minus: bw | divided_by: 2.0 -%}
{%- assign by = 132.0 | minus: bh -%}
{%- assign sx = bw | divided_by: 100.0 -%}{%- assign sy = bh | divided_by: 100.0 -%}
{%- assign bxr = bx | plus: bw -%}
{%- assign hx = bx | minus: 16 -%}{%- assign hlx = bx | minus: 24 -%}
{%- assign hmid = bh | divided_by: 2.0 | plus: by -%}
{%- assign bot = by | plus: bh -%}
