</g>
<g stroke="var(--a-ochre)" stroke-width="1" fill="none">
<line x1="{{ bx }}" y1="148" x2="{{ bxr }}" y2="148"/><line x1="{{ bx }}" y1="143" x2="{{ bx }}" y2="153"/><line x1="{{ bxr }}" y1="143" x2="{{ bxr }}" y2="153"/>
<line x1="{{ hx }}" y1="{{ by }}" x2="{{ hx }}" y2="{{ bot }}"/><line x1="{{ hx | minus: 5 }}" y1="{{ by }}" x2="{{ hx | plus: 5 }}" y2="{{ by }}"/><line x1="{{ hx | minus: 5 }}" y1="{{ bot }}" x2="{{ hx | plus: 5 }}" y2="{{ bot }}"/>
</g>
<text x="150" y="168" text-anchor="middle">{% if dp[0] == dp[1] %}Ø {% endif %}{{ dp[0] | strip }} cm</text>
<text transform="rotate(-90 {{ hlx }} {{ hmid }})" x="{{ hlx }}" y="{{ hmid }}" text-anchor="middle">{{ dp[2] | strip }} cm</text>
</svg>
<figcaption class="atl-dims__cap">{%- if dp[0] != dp[1] -%}<span><b>Depth</b>{{ db }} cm</span>{%- endif -%}{%- if sz[1] != blank -%}<span><b>Weight</b>{{ sz[1] | strip | remove: 'kg' | strip }} kg</span>{%- endif -%}</figcaption></figure>
{%- endif -%}{%- endif -%}
{%- endfor -%}
{%- if ents.size > 1 -%}<script>document.addEventListener('change',function(e){var t=e.target;if(!t||!t.matches||!t.matches('variant-selects input[type=radio]'))return;var v=String(t.value).toLowerCase();document.querySelectorAll('.atl-dims[data-size]').forEach(function(f){f.classList.toggle('is-on',f.getAttribute('data-size')===v)})});</script>{%- endif -%}
{%- when 'trust' -%}{%- capture nrv -%}{%- render 'atelier-returns', part: 'flag', product: product -%}{%- endcapture -%}{%- assign nrv = nrv | strip -%}<div class="atl-trust" data-nr="{{ nrv }}"><div>{{- 'icon-truck.svg' | inline_asset_content -}}<span>Free shipping</span></div><div>{{- 'icon-return.svg' | inline_asset_content -}}<span class="ret-y">Easy 7-day returns</span><span class="ret-n">Replaced if damaged</span></div><div>{{- 'icon-lock.svg' | inline_asset_content -}}<span>Secured by Razorpay</span></div></div>
