{% comment %}
  Floating WhatsApp chat bubble, shown site-wide.

  Reads the phone number and default message from the "WhatsApp chat"
  theme settings group (config/settings_schema.json).
{% endcomment %}
{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
-%}
{%- if settings.whatsapp_enable and settings.whatsapp_show_bubble and wa_number != blank -%}
  {{ 'component-whatsapp-bubble.css' | asset_url | stylesheet_tag }}
  <a
    href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}"
    class="whatsapp-bubble"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ 'general.whatsapp.chat_with_us' | t }}"
  >
    <span class="svg-wrapper">{{- 'icon-whatsapp.svg' | inline_asset_content -}}</span>
  </a>
{%- endif -%}
